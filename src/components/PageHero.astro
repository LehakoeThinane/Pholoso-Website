---
/**
 * PageHero: the opening of every page other than Home. Holds the page's only <h1>.
 *
 * Props:
 * - title: the <h1> text
 * - eyebrow: short label above the heading
 * - lead: one or two plain sentences saying what this page is for
 * - level: 1 (default). Only the styleguide uses 2, to keep one <h1> per page.
 *
 * Slot: default (extra content under the lead, such as a Listen button or a notice).
 */
interface Props {
  title: string;
  eyebrow?: string;
  lead?: string;
  level?: 1 | 2;
}

const { title, eyebrow, lead, level = 1 } = Astro.props;
const Heading = `h${level}` as 'h1' | 'h2';
---

<div class="page-hero">
  <div class="container">
    {eyebrow && <p class="page-hero__eyebrow triangle-marker">{eyebrow}</p>}
    <Heading class="page-hero__title">{title}</Heading>
    {lead && <p class="page-hero__lead">{lead}</p>}
    <slot />
  </div>
</div>

<style>
  /* Centred (owner decision, 18 Nov 2026): headings and short text. Long text stays left. */
  .page-hero {
    background-color: var(--color-surface);
    padding-block: var(--space-xl);
    text-align: center;
    border-bottom: var(--border-width) solid var(--color-line);
  }
  .page-hero__eyebrow {
    margin-inline: auto;
    font-weight: 700;
    font-size: var(--step--1);
    color: var(--color-text-muted);
    margin-bottom: var(--space-2xs);
  }
  .page-hero__title {
    max-width: 15.65em; /* = 24ch in Atkinson Bold; em, so it does not change when the font swaps in */
    margin-inline: auto;
  }
  .page-hero__lead {
    font-size: var(--step-1);
    color: var(--color-text-muted);
    margin: 0 auto;
  }
  /* Anything else placed in the hero (notices, buttons) is centred as a block; notices keep
     their own left-aligned text */
  .page-hero :global(.container > :not(.page-hero__eyebrow, .page-hero__title, .page-hero__lead)) {
    margin-inline: auto;
  }
  .page-hero :global(.notice) {
    text-align: left;
  }
</style>
