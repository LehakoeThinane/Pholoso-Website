---
/**
 * InterestExplorer: shows how one interest can open a door into four areas of learning.
 * Its styles are in src/styles/explorer.css: a page that uses it links that file in its head
 * (so other pages do not download them)
 * (the Hlompho principle). Without JavaScript all interests are shown, one section each.
 * With JavaScript (src/scripts/interests.ts) a row of toggle buttons (aria-pressed) shows
 * one interest at a time.
 *
 * Props:
 * - id: unique id for the explorer
 * - interests: [{ slug, name, cards: [{ area, text }] }], from the `interests` collection
 * - level: heading level for each interest name (default 3)
 */
interface Interest {
  slug: string;
  name: string;
  title: string;
  cards: { area: string; text: string }[];
}
interface Props {
  id: string;
  interests: Interest[];
  level?: 3 | 4;
}

const { id, interests, level = 3 } = Astro.props;
const Heading = `h${level}` as 'h3' | 'h4';
const CardHeading = `h${level + 1}` as 'h4' | 'h5';
---

<div class="explorer" id={id} data-explorer>
  <div class="explorer__picker" data-js-only data-explorer-picker>
    <p class="explorer__picker-label" id={`${id}-label`}>
      Choose an interest
    </p>
    <div class="explorer__buttons" role="group" aria-labelledby={`${id}-label`}>
      {interests.map((interest, i) => (
        <button
          type="button"
          class="explorer__button"
          aria-pressed={i === 0 ? 'true' : 'false'}
          aria-controls={`${id}-${interest.slug}`}
          data-interest={interest.slug}
        >
          {interest.name}
        </button>
      ))}
    </div>
  </div>

  {interests.map((interest, i) => (
    <section
      class="explorer__panel"
      id={`${id}-${interest.slug}`}
      aria-labelledby={`${id}-${interest.slug}-title`}
      data-interest-panel={interest.slug}
      data-js-hide={i === 0 ? undefined : true}
    >
      <Heading class="explorer__title" id={`${id}-${interest.slug}-title`}>
        {interest.title}
      </Heading>
      <ul class="explorer__cards">
        {interest.cards.map((card) => (
          <li class="explorer__card">
            <CardHeading class="explorer__area">{card.area}</CardHeading>
            <p>{card.text}</p>
          </li>
        ))}
      </ul>
    </section>
  ))}
  <p class="visually-hidden" aria-live="polite" data-explorer-status></p>
</div>
