---
/**
 * Disclosure: native <details>/<summary>, for FAQs and "read more" content.
 * Works with keyboard and screen readers without JavaScript.
 *
 * Props:
 * - summary: the always-visible question or label
 * - open: start expanded
 * - level: wrap the summary text in a heading of this level (so FAQs appear in the
 *   page outline). Omit for plain summaries.
 * - id: anchor id
 */
interface Props {
  summary: string;
  open?: boolean;
  level?: 2 | 3 | 4;
  id?: string;
}

const { summary, open = false, level, id } = Astro.props;
const Heading = level ? (`h${level}` as 'h2' | 'h3' | 'h4') : 'span';
---

<details class="disclosure" open={open} id={id}>
  <summary class="disclosure__summary">
    <Heading class="disclosure__label">{summary}</Heading>
  </summary>
  <div class="disclosure__body">
    <slot />
  </div>
</details>

<style>
  .disclosure {
    border-bottom: var(--border-width) solid var(--color-border);
  }
  .disclosure:first-of-type {
    border-top: var(--border-width) solid var(--color-border);
  }
  .disclosure__summary {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    min-height: var(--button-min);
    padding-block: var(--space-xs);
    cursor: pointer;
    list-style: none;
  }
  .disclosure__summary::-webkit-details-marker {
    display: none;
  }
  .disclosure__summary::before {
    content: '+';
    flex: none;
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border: 2px solid currentColor;
    border-radius: 50%;
    font-weight: 700;
    line-height: 1;
  }
  .disclosure[open] > .disclosure__summary::before {
    content: '−';
  }
  .disclosure__label {
    margin: 0;
    font-size: var(--step-1);
    font-weight: 700;
  }
  .disclosure__body {
    padding: 0 0 var(--space-m) calc(1.5rem + var(--space-xs));
  }
  .disclosure__body > :global(:last-child) {
    margin-bottom: 0;
  }
</style>
