---
/**
 * Checkbox: a single checkbox, typically for consent.
 *
 * Props:
 * - name, label: required. The label is the full consent sentence.
 * - required: default false; optional ones show "(optional)"
 * - hint: extra explanation under the label
 * - value: submitted value (default "yes")
 * - error: error message to show now (styleguide); the form script fills it at runtime
 * - id: defaults to "f-<name>"; set it when two forms on one page use the same name
 *
 * Slot: optional rich label content (e.g. with a link to the privacy notice). If given, it
 * replaces `label`, which is then only used for the error summary.
 */
interface Props {
  name: string;
  label: string;
  required?: boolean;
  hint?: string;
  value?: string;
  error?: string;
  id?: string;
}

const { name, label, required = false, hint, value = 'yes', error, id = `f-${name}` } = Astro.props;
const hintId = hint ? `${id}-hint` : undefined;
const errorId = `${id}-error`;
const describedBy = [hintId, error ? errorId : undefined].filter(Boolean).join(' ') || undefined;
const hasSlot = Astro.slots.has('default');
---

<div class:list={['checkbox', { 'checkbox--error': error }]}>
  <p class="checkbox__error" id={errorId} hidden={!error}>
    <span class="visually-hidden">Error: </span>
    <span class="field__error-text">{error}</span>
  </p>
  <div class="checkbox__row">
    <input
      type="checkbox"
      id={id}
      name={name}
      value={value}
      required={required}
      aria-describedby={describedBy}
      aria-invalid={error ? 'true' : undefined}
      data-hint-id={hintId}
      data-error-id={errorId}
      data-label={label}
    />
    <label for={id}>
      {hasSlot ? <slot /> : label}
      {!required && <span class="checkbox__optional"> (optional)</span>}
    </label>
  </div>
  {hint && (
    <p class="checkbox__hint" id={hintId}>
      {hint}
    </p>
  )}
</div>

<style>
  .checkbox {
    margin-bottom: var(--space-m);
    max-width: var(--measure);
  }
  .checkbox--error {
    padding-left: var(--space-s);
    border-left: 4px solid var(--color-error);
  }
  .checkbox__row {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-xs);
    align-items: start;
  }
  .checkbox__row input {
    width: 1.5rem;
    height: 1.5rem;
    margin: 0.6rem 0 0;
    accent-color: var(--color-btn-bg);
  }
  .checkbox__row label {
    display: block;
    min-height: var(--target-min);
    padding-block: var(--space-2xs);
    cursor: pointer;
  }
  .checkbox__optional {
    color: var(--color-text-muted);
  }
  .checkbox__hint {
    margin: 0 0 0 calc(1.5rem + var(--space-xs));
    font-size: var(--step--1);
    color: var(--color-text-muted);
  }
  .checkbox__error {
    margin: 0 0 var(--space-2xs);
    color: var(--color-error);
    font-weight: 700;
  }
  .checkbox__error[hidden] {
    display: none;
  }
</style>
