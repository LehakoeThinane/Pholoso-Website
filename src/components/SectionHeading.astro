---
/**
 * SectionHeading: the heading, and an optional lead.
 *
 * Props:
 * - title: heading text
 * - id: heading id (pass the same id to Section's `labelledby`)
 * - lead: one or two sentences below the heading
 * - level: 2 (default), 3 or 4. Keep the page outline strict: h1 → h2 → h3.
 */
interface Props {
  title: string;
  id?: string;
  lead?: string;
  level?: 2 | 3 | 4;
}

const { title, id, lead, level = 2 } = Astro.props;
const Heading = `h${level}` as 'h2' | 'h3' | 'h4';
---

<div class="section-heading">
  <Heading id={id} class="section-heading__title">
    {title}
  </Heading>
  {lead && <p class="section-heading__lead">{lead}</p>}
  <slot />
</div>

<style>
  /* Centred (owner decision, 18 Nov 2026): headings and short text. Long text stays left. */
  .section-heading {
    margin: 0 auto var(--space-l);
    max-width: var(--measure);
    text-align: center;
  }
  .section-heading__title {
    margin-bottom: var(--space-xs);
  }
  .section-heading__lead {
    font-size: var(--step-1);
    color: var(--color-text-muted);
    margin-bottom: 0;
  }
</style>
