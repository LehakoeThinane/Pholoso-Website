---
/**
 * ChoiceGroup: a fieldset of radio buttons (one answer) or checkboxes (several).
 *
 * Props:
 * - name, legend: required
 * - options: [{ value, label, hint? }]
 * - type: 'radio' (default) | 'checkbox'
 * - required: default false (for radios, the first option is NOT preselected)
 * - hint: help under the legend
 * - value: preselected value
 * - error: error message to show now (styleguide); the form script fills it at runtime
 * - inline: lay short options out in a row on wider screens
 */
type Option = { value: string; label: string; hint?: string };
interface Props {
  name: string;
  legend: string;
  options: Option[];
  type?: 'radio' | 'checkbox';
  required?: boolean;
  hint?: string;
  value?: string;
  error?: string;
  inline?: boolean;
}

const {
  name,
  legend,
  options,
  type = 'radio',
  required = false,
  hint,
  value,
  error,
  inline = false,
} = Astro.props;
const base = `f-${name}`;
const hintId = hint ? `${base}-hint` : undefined;
const errorId = `${base}-error`;
const describedBy = [hintId, error ? errorId : undefined].filter(Boolean).join(' ') || undefined;
---

<fieldset
  class:list={['choices', { 'choices--error': error, 'choices--inline': inline }]}
  id={base}
  aria-describedby={describedBy}
  data-hint-id={hintId}
  data-error-id={errorId}
  data-choice-group={name}
>
  <legend class="choices__legend">
    {legend}
    {!required && <span class="choices__optional"> (optional)</span>}
  </legend>
  {hint && (
    <p class="choices__hint" id={hintId}>
      {hint}
    </p>
  )}
  <p class="choices__error" id={errorId} hidden={!error}>
    <span class="visually-hidden">Error: </span>
    <span class="field__error-text">{error}</span>
  </p>
  <div class="choices__options">
    {options.map((o, i) => {
      const id = `${base}-${i}`;
      return (
        <div class="choices__item">
          <input
            type={type}
            id={id}
            name={name}
            value={o.value}
            checked={o.value === value}
            required={required && type === 'radio'}
            aria-describedby={o.hint ? `${id}-hint` : undefined}
          />
          <label for={id}>{o.label}</label>
          {o.hint && (
            <p class="choices__item-hint" id={`${id}-hint`}>
              {o.hint}
            </p>
          )}
        </div>
      );
    })}
  </div>
</fieldset>

<style>
  .choices {
    border: 0;
    padding: 0;
    margin: 0 0 var(--space-m);
    min-width: 0;
  }
  .choices__legend {
    font-weight: 700;
    padding: 0;
    margin-bottom: var(--space-2xs);
  }
  .choices__optional {
    font-weight: 400;
    color: var(--color-text-muted);
  }
  .choices__hint {
    margin: 0 0 var(--space-2xs);
    color: var(--color-text-muted);
    font-size: var(--step--1);
  }
  .choices__error {
    margin: 0 0 var(--space-2xs);
    color: var(--color-error);
    font-weight: 700;
  }
  .choices__error[hidden] {
    display: none;
  }
  .choices--error {
    padding-left: var(--space-s);
    border-left: 4px solid var(--color-error);
  }
  .choices__options {
    display: grid;
    gap: var(--space-2xs);
  }
  @media (min-width: 40rem) {
    .choices--inline .choices__options {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2xs) var(--space-l);
    }
  }
  .choices__item {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    column-gap: var(--space-xs);
  }
  .choices__item input {
    width: 1.5rem;
    height: 1.5rem;
    margin: 0;
    accent-color: var(--color-btn-bg);
  }
  .choices__item label {
    display: flex;
    align-items: center;
    min-height: var(--target-min);
    cursor: pointer;
  }
  .choices__item-hint {
    grid-column: 2;
    margin: 0;
    font-size: var(--step--1);
    color: var(--color-text-muted);
  }
</style>
