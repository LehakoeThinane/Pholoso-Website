---
/**
 * Stat: a sourced statistic. Every statistic on the site shows its source as a link
 * (brief §7, §16). Never add a statistic without a primary source.
 *
 * Props:
 * - figure: the number as written ("Up to 70%", "About 1 in 100")
 * - text: what the number means, in one plain sentence
 * - source: { label, href, prefix? }. prefix defaults to "Source:"; use
 *   "According to studies cited in" where the source is a review of other studies.
 */
import ExternalLink from './ExternalLink.astro';

interface Props {
  figure: string;
  text: string;
  source: { label: string; href: string; prefix?: string };
}

const { figure, text, source } = Astro.props;
---

<figure class="stat">
  <p class="stat__figure">{figure}</p>
  <p class="stat__text">{text}</p>
  <figcaption class="stat__source">
    {`${source.prefix ?? 'Source:'} `}
    <ExternalLink href={source.href}>{source.label}</ExternalLink>
  </figcaption>
</figure>

<style>
  /*
   * A card: rounded, soft border and shadow, the gloss, a short gold bar above the figure, all
   * centred. Cards in a row are the same height, and the source line sits at the bottom of each,
   * so the sources line up across the row.
   */
  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 100%;
    margin: 0;
    padding: var(--space-l);
    text-align: center;
    border: var(--border-width) solid var(--color-line);
    border-radius: var(--radius-l);
    background-color: var(--color-bg);
    box-shadow: var(--card-glow);
  }
  .stat::before {
    content: '';
    width: 3rem;
    height: 4px;
    margin-bottom: var(--space-m);
    border-radius: 2px;
    background-color: var(--color-accent);
  }
  .stat__figure {
    font-size: var(--step-4);
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: var(--space-xs);
  }
  .stat__text {
    font-size: var(--step-1);
    margin-bottom: var(--space-m);
  }
  .stat__source {
    margin-top: auto;
    /* Room for two lines in every card, so the dividers line up across a row */
    min-height: calc(2 * var(--line-height) * 1em + var(--space-s));
    padding-top: var(--space-s);
    border-top: var(--border-width) solid var(--color-line);
    width: 100%;
    font-size: var(--step--1);
    color: var(--color-text-muted);
  }
  /* Glow brightens on hover; the card lifts a little only when motion is allowed */
  @media (hover: hover) {
    .stat:hover {
      box-shadow: var(--card-glow-hover);
    }
    :global([data-anim]) .stat:hover {
      translate: 0 -3px;
    }
  }
  :global([data-anim]) .stat {
    transition:
      translate 0.2s ease-out,
      box-shadow 0.2s ease-out;
  }
</style>
