---
/**
 * Value: prints a value from src/config/site.ts. If it is still a "TODO:" placeholder,
 * prints a visible "To be confirmed" badge instead (preview builds only; production
 * builds refuse to run while placeholders remain).
 *
 * Props:
 * - value: the config value
 */
import { strings } from '../config/strings';
import { isTodo } from '../lib/todo';

interface Props {
  value: string;
}

const { value } = Astro.props;
---

{isTodo(value) ? (
  <span class="todo-badge" title={value}>
    {strings.toBeConfirmed}
  </span>
) : (
  value
)}

<style>
  .todo-badge {
    display: inline-block;
    padding: 0 var(--space-2xs);
    border: 2px dashed var(--color-error);
    border-radius: var(--radius-s);
    color: var(--color-error);
    font-weight: 700;
    font-size: 0.9em;
  }
</style>
