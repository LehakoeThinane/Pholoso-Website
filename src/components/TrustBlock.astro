---
/**
 * TrustBlock: why donors, families and partners can trust the Foundation: safeguarding,
 * privacy, accessibility, respectful language, the policies, and the registration line.
 * Wording from the Foundation's original website (the owner's own statements).
 *
 * Props:
 * - headingLevel: level of each item heading (default 3)
 */
import CardGrid from './CardGrid.astro';
import RegistrationLine from './RegistrationLine.astro';

interface Props {
  headingLevel?: 3 | 4;
}

const { headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as 'h3' | 'h4';
---

<div class="trust">
  <CardGrid columns={2} as="ul">
    <li class="trust__item">
      <Heading>Child safeguarding</Heading>
      <p>
        A signed safeguarding policy and code of conduct govern every interaction with children.
        Guardian consent and dignity come first.
      </p>
    </li>
    <li class="trust__item">
      <Heading>Privacy, by design</Heading>
      <p>
        The platform is built to strict POPIA and EU standards for children's privacy. No child is
        identifiable. Children choose their own pseudonyms and avatars to represent them. Read our{' '}
        <a href="/privacy/">privacy notice</a>.
      </p>
    </li>
    <li class="trust__item">
      <Heading>Accessibility, built in</Heading>
      <p>
        This site targets WCAG 2.2 AA. The Comfort and Access controls let you shape it to your own
        needs.
      </p>
    </li>
    <li class="trust__item">
      <Heading>Respectful language</Heading>
      <p>
        We use person-first language, child with autism, as our default. We also respect each
        person's own preference, and you can switch to identity-first at any time.{' '}
        <a href="/accessibility/#wording">Read more about wording</a>.
      </p>
    </li>
  </CardGrid>
  <p class="trust__policies">
    Our Safeguarding Policy, Data Protection and Privacy Policy, Code of Conduct and Governance
    framework guide this work and are available to partners and funders.
  </p>
  <RegistrationLine class="trust__registration" />
</div>

<style>
  .trust__item {
    box-shadow: var(--elevation);
    padding: var(--space-m);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-m);
    background-color: var(--color-bg);
  }
  .trust__item :global(h3),
  .trust__item :global(h4) {
    font-size: var(--step-1);
  }
  .trust__item p {
    margin: 0;
  }
  /* Each item is the card itself: keep the text right under its heading */
  .trust .trust__item > :global(*) {
    flex: none;
  }
  .trust__policies {
    margin: var(--space-m) auto 0;
    text-align: center;
  }
  .trust :global(.trust__registration) {
    margin-top: var(--space-m);
  }
</style>
