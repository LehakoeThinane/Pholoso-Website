---
/**
 * HelpRouter: "How can we help?" (brief v5 §10, mood board "Grown-ups' pages"). Four large
 * rows that start from the visitor's situation rather than from our menu, each with a
 * two-tone green-and-gold icon, plain words and an arrow.
 *
 * Props: id (for the heading), rows (optional: replace the default four).
 */
type Icon = 'child' | 'school' | 'fund' | 'self';
interface Row {
  href: string;
  label: string;
  icon: Icon;
}
interface Props {
  id?: string;
  rows?: Row[];
}

const {
  id = 'help-router-title',
  rows = [
    { href: '/parent-guide/', label: 'My child learns differently.', icon: 'child' },
    { href: '/get-involved/#schools', label: 'I’m a teacher or a school.', icon: 'school' },
    { href: '/get-involved/#donors', label: 'I want to fund change.', icon: 'fund' },
    { href: '/stories/', label: 'I’m neurodivergent myself.', icon: 'self' },
  ],
} = Astro.props;
---

<div class="router">
  <h2 class="router__title" id={id}>
    How can we help?
  </h2>
  <ul class="router__list">
    {rows.map((r) => (
      <li>
        <a class="router__row" href={r.href}>
          <span class="router__icon" aria-hidden="true">
            <svg viewBox="0 0 44 44" focusable="false">
              {r.icon === 'child' && (
                <>
                  <circle class="ri-fill" cx="22" cy="13" r="7" />
                  <path class="ri-line" d="M10 38c0-8 5-13 12-13s12 5 12 13" />
                  <path
                    class="ri-accent"
                    d="M31 7l1.5 3 3 .5-2.2 2.2.6 3.1-2.9-1.5-2.9 1.5.6-3.1-2.2-2.2 3-.5z"
                  />
                </>
              )}
              {r.icon === 'school' && (
                <>
                  <path class="ri-fill" d="M6 17L22 8l16 9-16 9z" />
                  <path class="ri-line" d="M12 21v9c3 3 7 4 10 4s7-1 10-4v-9M38 17v10" />
                </>
              )}
              {r.icon === 'fund' && (
                <>
                  <path
                    class="ri-fill"
                    d="M22 20c-4-6-12-4-11 2 1 5 11 11 11 11s10-6 11-11c1-6-7-8-11-2z"
                  />
                  <path class="ri-line" d="M6 36h32M22 33v3" />
                </>
              )}
              {r.icon === 'self' && (
                <>
                  <circle class="ri-line" cx="20" cy="14" r="7" />
                  <path class="ri-line" d="M8 38c0-8 5-13 12-13 4 0 7 1.5 9 4" />
                  <path
                    class="ri-fill"
                    d="M33 26l2.4 4.8 5.1.7-3.7 3.6.9 5.1-4.7-2.4-4.7 2.4.9-5.1-3.7-3.6 5.1-.7z"
                  />
                </>
              )}
            </svg>
          </span>
          <span class="router__label">{r.label}</span>
          <svg class="router__arrow" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </li>
    ))}
  </ul>
</div>

<style>
  .router {
    max-width: 44rem;
    margin-inline: auto;
  }
  .router__title {
    text-align: center;
  }
  .router__list {
    display: grid;
    gap: var(--space-s);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .router__list li {
    margin: 0;
    max-width: none;
  }
  .router__row {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    min-height: 4.25rem;
    padding: var(--space-2xs) var(--space-m);
    border: var(--border-width) solid var(--color-line);
    border-radius: var(--radius-l);
    background-color: var(--color-bg);
    box-shadow: var(--card-glow);
    color: var(--color-text);
    text-decoration: none;
  }
  .router__row:hover {
    box-shadow: var(--card-glow-hover);
  }
  .router__row:hover .router__label {
    text-decoration: underline;
  }
  .router__icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-m);
    background-color: var(--color-surface);
  }
  .router__icon svg {
    width: 2.3rem;
    height: 2.3rem;
  }
  .ri-fill {
    fill: var(--gold);
    stroke: var(--green-deep);
    stroke-width: 2.2;
    stroke-linejoin: round;
  }
  .ri-line {
    fill: none;
    stroke: var(--green-deep);
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .ri-accent {
    fill: var(--gold);
  }
  .router__label {
    flex: 1;
    font-size: var(--step-1);
    font-weight: 700;
    text-align: left;
  }
  .router__arrow {
    flex: none;
    width: 1.6rem;
    height: 1.6rem;
    fill: none;
    stroke: var(--color-link);
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* Phones: a little more room for the words */
  @media (max-width: 30rem) {
    .router__row {
      gap: var(--space-xs);
      padding-inline: var(--space-s);
    }
    .router__label {
      font-size: var(--step-0);
    }
  }
  :global([data-anim]) .router__row {
    transition:
      translate 0.15s ease-out,
      box-shadow 0.15s ease-out;
  }
  @media (hover: hover) {
    :global([data-anim]) .router__row:hover {
      translate: 0 -2px;
    }
  }
  /* High contrast and forced colours: plain outlines */
  :global([data-theme='contrast']) .ri-fill,
  :global([data-theme='contrast']) .ri-accent {
    fill: var(--color-bg);
    stroke: var(--color-text);
  }
</style>
