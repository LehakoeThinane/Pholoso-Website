---
/**
 * Panel: a filled box for grouped facts (for example the two-entity panel on About,
 * or the sidebar on Contact). Quieter than a Card.
 *
 * Props:
 * - title: optional heading
 * - level: heading level (default 3)
 * - as: 'div' (default) or 'aside' for complementary content
 * - label: accessible name when `as` is 'aside' and there is no title
 */
interface Props {
  title?: string;
  level?: 2 | 3 | 4;
  as?: 'div' | 'aside';
  label?: string;
}

const { title, level = 3, as: Tag = 'div', label } = Astro.props;
const Heading = `h${level}` as 'h2' | 'h3' | 'h4';
---

<Tag class="panel" aria-label={!title && label ? label : undefined}>
  {title && <Heading class="panel__title">{title}</Heading>}
  <slot />
</Tag>

<style>
  .panel {
    padding: var(--space-m);
    background: var(--color-surface);
    border: var(--border-width) solid var(--color-line);
    border-left: 4px solid var(--color-accent);
    border-radius: var(--radius-m);
  }
  .panel__title {
    font-size: var(--step-1);
  }
  .panel > :global(:last-child) {
    margin-bottom: 0;
  }
</style>
