---
/**
 * SiteFooter: simple, short and centred in one column (owner's requests, 23–24 November 2026):
 * 1. The logo and tagline, then one line of links to the main pages.
 * 2. How to reach us: the email address (owner's decision, 24 November 2026: no postal
 *    address or phone number in the footer).
 * 3. Centred: the registration numbers, then copyright, Privacy, Accessibility and
 *    Comfort & access.
 * The updates sign-up lives on the Resources page. Leaves room at the bottom for the floating
 * Comfort & access button. No props.
 */
import { Image } from 'astro:assets';
import logo from '../assets/logo/logo.png';
import { registrationLine, site } from '../config/site';
import { footerLinks, strings } from '../config/strings';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__main">
    <div class="site-footer__brand">
      <Image src={logo} alt={site.name} width={160} densities={[1, 2]} class="site-footer__logo" />
      <p class="site-footer__tagline">{site.tagline}</p>
    </div>
    <nav aria-label={strings.footerNavLabel}>
      <ul class="site-footer__links">
        {footerLinks.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <address class="container site-footer__contact">
    <strong>Email:</strong> <a href={`mailto:${site.email}`}>{site.email}</a>
  </address>

  <div class="container site-footer__legal">
    <p class="site-footer__registration">{registrationLine}</p>
    <ul class="site-footer__links">
      <li>{`© ${year} ${site.name}. All rights reserved.`}</li>
      <li>
        <a href="/privacy/">{strings.footer.privacy}</a>
      </li>
      <li>
        <a href="/accessibility/">{strings.footer.accessibility}</a>
      </li>
      <li>
        <a href="/accessibility/#comfort" data-open-comfort>
          Comfort &amp; access
        </a>
      </li>
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-surface);
    border-top: var(--border-width) solid var(--color-line);
    padding-top: var(--space-l);
    /* Room for the floating Comfort & access button */
    padding-bottom: calc(var(--space-s) + var(--button-min));
    font-size: var(--step--1);
  }
  /* One centred column: logo, tagline, links, then email and the legal lines */
  .site-footer__main {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-s);
    text-align: center;
  }
  .site-footer__brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2xs);
  }
  .site-footer__logo {
    width: 8rem;
    height: auto;
  }
  .site-footer__tagline {
    margin: 0;
    color: var(--color-text-muted);
  }
  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0 var(--space-m);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .site-footer li {
    margin: 0;
  }
  .site-footer__links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
  }
  /* The email line: one line of text, centred (tall enough to tap comfortably) */
  .site-footer__contact {
    margin-top: var(--space-s);
    text-align: center;
    font-style: normal;
    line-height: var(--target-min);
  }
  /* Centred bottom line */
  .site-footer__legal {
    margin-top: var(--space-2xs);
    padding-top: var(--space-xs);
    border-top: var(--border-width) solid var(--color-line);
    color: var(--color-text-muted);
    text-align: center;
  }
  .site-footer__registration {
    margin: 0 auto;
    font-weight: 700;
    color: var(--color-text);
  }
  .site-footer__legal .site-footer__links {
    justify-content: center;
  }
</style>
