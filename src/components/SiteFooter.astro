---
/**
 * SiteFooter, in three tidy parts:
 * 1. Updates: a compact sign-up strip (heading and intro on the left; email and Sign up side by
 *    side on the right, with the consent tick below).
 * 2. Four even columns: logo and tagline, Explore, Get involved, Contact us.
 * 3. A bottom bar: the registration line, then copyright and the Privacy, Accessibility and
 *    Comfort & access links.
 * Leaves room at the bottom for the floating Comfort & access button. No props.
 */
import { Image } from 'astro:assets';
import logo from '../assets/logo/logo.png';
import { registrationLine, site } from '../config/site';
import { footerExplore, footerGetInvolved, strings } from '../config/strings';
import SignupForm from './SignupForm.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__updates">
      <SignupForm
        id="footer-signup"
        heading="Get occasional updates"
        intro="News about our work, a few times a year."
      />
    </div>
  </div>

  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <Image src={logo} alt={site.name} width={220} densities={[1, 2]} class="site-footer__logo" />
      <p class="site-footer__tagline">{site.tagline}</p>
    </div>

    <nav aria-label={strings.footerNavLabel} class="site-footer__nav">
      <div>
        <h2 class="site-footer__heading">{strings.footer.explore}</h2>
        <ul>
          {footerExplore.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h2 class="site-footer__heading">{strings.footer.getInvolved}</h2>
        <ul>
          {footerGetInvolved.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </nav>

    <div class="site-footer__contact">
      <h2 class="site-footer__heading">{strings.footer.contact}</h2>
      <ul>
        <li>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </li>
        <li>
          <a href="/contact/">Send us a message</a>
        </li>
        <li class="site-footer__place">{site.location}</li>
      </ul>
    </div>
  </div>

  <div class="container site-footer__legal">
    <p class="site-footer__registration">{registrationLine}</p>
    <ul class="site-footer__legal-links">
      <li>{`© ${year} ${site.name}`}</li>
      <li>
        <a href="/privacy/">{strings.footer.privacy}</a>
      </li>
      <li>
        <a href="/accessibility/">{strings.footer.accessibility}</a>
      </li>
      <li>
        <a href="/accessibility/#comfort" data-open-comfort>
          Comfort &amp; access settings
        </a>
      </li>
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-surface);
    border-top: var(--border-width) solid var(--color-line);
    padding-top: var(--space-xl);
    /* Room for the floating Comfort & access button */
    padding-bottom: calc(var(--space-xl) + var(--button-min));
    font-size: var(--step--1);
  }

  /* 1. Updates strip: a card across the top */
  .site-footer__updates {
    padding: var(--space-l); /* the same space on all four sides */
    border: var(--border-width) solid var(--color-line);
    border-radius: var(--radius-m);
    background-color: var(--color-bg);
    background-image: var(--gloss-surface);
  }
  .site-footer__updates :global(.signup) {
    display: grid;
    gap: 0 var(--space-xl);
    align-items: center;
  }
  .site-footer__updates :global(.signup__heading) {
    margin-bottom: var(--space-3xs);
  }
  .site-footer__updates :global(.signup > p) {
    margin: 0 0 var(--space-s);
    color: var(--color-text-muted);
  }
  /* Email field and Sign up button side by side; the other parts keep their own rows */
  .site-footer__updates :global(form) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: var(--space-s);
    max-width: none;
  }
  .site-footer__updates :global(form > *) {
    grid-column: 1 / -1;
  }
  .site-footer__updates :global(form > .field) {
    grid-column: 1;
    grid-row: 3;
    margin-bottom: 0;
  }
  .site-footer__updates :global(form > .button) {
    grid-column: 2;
    grid-row: 3;
    align-self: end;
  }
  .site-footer__updates :global(.signup__consent) {
    grid-row: 4;
    margin-top: var(--space-s);
  }
  /* The consent tick is the last item in this card: drop the spacing it carries for long forms,
     so the space under it matches the space above the email label (the card's own padding) */
  .site-footer__updates :global(.checkbox) {
    margin-bottom: 0;
  }
  .site-footer__updates :global(.checkbox__row label) {
    padding-bottom: 0;
  }
  /* Narrow phones: the email box full width, then the consent tick, then the button */
  @media (max-width: 29.99rem) {
    .site-footer__updates {
      padding: var(--space-m);
    }
    .site-footer__updates :global(form) {
      grid-template-columns: minmax(0, 1fr);
    }
    .site-footer__updates :global(form > .button) {
      grid-column: 1;
      grid-row: 5;
      justify-self: start;
      margin-top: var(--space-xs);
    }
  }
  @media (min-width: 48rem) {
    .site-footer__updates :global(.signup) {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
      grid-template-areas:
        'heading form'
        'intro form';
    }
    .site-footer__updates :global(.signup__heading) {
      grid-area: heading;
      align-self: end;
    }
    .site-footer__updates :global(.signup > p) {
      grid-area: intro;
      align-self: start;
      margin: 0;
    }
    .site-footer__updates :global(form) {
      grid-area: form;
    }
  }

  /* 2. Four even columns */
  .site-footer__grid {
    display: grid;
    gap: var(--space-l);
    margin-top: var(--space-xl);
  }
  @media (min-width: 40rem) {
    .site-footer__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 62rem) {
    .site-footer__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    /* The two link lists are columns 2 and 3 of the same grid */
    .site-footer__nav {
      grid-column: span 2;
    }
  }
  .site-footer__nav {
    display: grid;
    gap: var(--space-l);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .site-footer__logo {
    width: 11rem;
    height: auto;
    margin-bottom: var(--space-s);
  }
  .site-footer__tagline {
    font-size: var(--step-0);
    font-weight: 700;
    max-width: 22rem;
  }
  .site-footer__heading {
    font-size: var(--step-0);
    margin-bottom: var(--space-2xs);
  }
  .site-footer ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .site-footer li {
    margin: 0;
  }
  .site-footer__grid li a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
  }
  .site-footer__place {
    padding-top: var(--space-2xs);
    color: var(--color-text-muted);
  }

  /* 3. Bottom bar */
  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-l);
    margin-top: var(--space-xl);
    padding-top: var(--space-m);
    border-top: var(--border-width) solid var(--color-line);
    color: var(--color-text-muted);
  }
  .site-footer__registration {
    margin: 0;
    font-weight: 700;
    color: var(--color-text);
  }
  .site-footer__legal-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--space-m);
  }
  .site-footer__legal-links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
  }
</style>
