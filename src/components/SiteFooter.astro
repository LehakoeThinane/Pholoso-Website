---
/**
 * SiteFooter: simple and short (owner's request, 23 November 2026). Two rows:
 * 1. The logo and tagline, then one line of links (the main pages, Donate and the email address).
 * 2. A thin bottom line: the registration numbers, copyright, Privacy, Accessibility and
 *    Comfort & access.
 * The updates sign-up lives on the Resources page. Leaves room at the bottom for the floating
 * Comfort & access button. No props.
 */
import { Image } from 'astro:assets';
import logo from '../assets/logo/logo.png';
import { registrationLine, site } from '../config/site';
import { footerLinks, strings } from '../config/strings';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__main">
    <div class="site-footer__brand">
      <Image src={logo} alt={site.name} width={160} densities={[1, 2]} class="site-footer__logo" />
      <p class="site-footer__tagline">{site.tagline}</p>
    </div>
    <nav aria-label={strings.footerNavLabel}>
      <ul class="site-footer__links">
        {footerLinks.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
        <li>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </li>
      </ul>
    </nav>
  </div>

  <div class="container site-footer__legal">
    <p>{registrationLine}</p>
    <ul class="site-footer__links">
      <li>{`© ${year} ${site.name}. All rights reserved.`}</li>
      <li>
        <a href="/privacy/">{strings.footer.privacy}</a>
      </li>
      <li>
        <a href="/accessibility/">{strings.footer.accessibility}</a>
      </li>
      <li>
        <a href="/accessibility/#comfort" data-open-comfort>
          Comfort &amp; access
        </a>
      </li>
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-surface);
    border-top: var(--border-width) solid var(--color-line);
    padding-top: var(--space-l);
    /* Room for the floating Comfort & access button */
    padding-bottom: calc(var(--space-m) + var(--button-min));
    font-size: var(--step--1);
  }
  .site-footer__main {
    display: grid;
    gap: var(--space-s) var(--space-xl);
    align-items: center;
  }
  @media (min-width: 62rem) {
    .site-footer__main {
      grid-template-columns: auto minmax(0, 1fr);
    }
  }
  .site-footer__brand {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs) var(--space-m);
  }
  .site-footer__logo {
    width: 8rem;
    height: auto;
  }
  .site-footer__tagline {
    margin: 0;
    max-width: 19rem;
    color: var(--color-text-muted);
  }
  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--space-m);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  @media (min-width: 62rem) {
    .site-footer__main .site-footer__links {
      justify-content: flex-end;
    }
  }
  .site-footer li {
    margin: 0;
  }
  .site-footer__links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
  }
  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 var(--space-l);
    margin-top: var(--space-s);
    padding-top: var(--space-2xs);
    border-top: var(--border-width) solid var(--color-line);
    color: var(--color-text-muted);
  }
  .site-footer__legal p {
    margin: 0;
  }
</style>
