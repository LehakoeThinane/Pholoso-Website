---
/**
 * Hero: the home page's opening band (dark green). Holds the only <h1> on the page.
 *
 * Props:
 * - eyebrow: short label above the heading
 * - title: the <h1> text
 * - image: imported hero photo (loaded with high priority)
 * - imageAlt: description of the photo, or "" if decorative
 * - level: 1 (default). Only the styleguide uses 2, to keep one <h1> per page.
 * - id: optional anchor id (the home page's "I'm a grown-up" door links to it).
 *
 * Slots: default (one-sentence explanation), "actions" (buttons).
 */
import type { ImageMetadata } from 'astro';
import Photo from './Photo.astro';

interface Props {
  eyebrow?: string;
  title: string;
  image: ImageMetadata;
  imageAlt: string;
  level?: 1 | 2;
  id?: string;
}

const { eyebrow, title, image, imageAlt, level = 1, id } = Astro.props;
const Heading = `h${level}` as 'h1' | 'h2';
---

<section class="hero on-dark" aria-labelledby="hero-title" id={id} tabindex={id ? -1 : undefined}>
  <div class="container hero__grid">
    <div class="hero__text">
      {eyebrow && <p class="hero__eyebrow triangle-marker">{eyebrow}</p>}
      <Heading id="hero-title" class="hero__title">
        {title}
      </Heading>
      <div class="hero__lead">
        <slot />
      </div>
      <div class="hero__actions">
        <slot name="actions" />
      </div>
    </div>
    <div class="hero__media">
      <Photo
        src={image}
        alt={imageAlt}
        priority
        sizes="(min-width: 62rem) 34rem, 100vw"
        widths={[360, 560, 720, 1080]}
      />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-xl) var(--space-2xl);
  }
  .hero:focus {
    outline: none;
  }
  .hero__grid {
    display: grid;
    gap: var(--space-l);
    align-items: center;
  }
  @media (min-width: 62rem) {
    .hero__grid {
      grid-template-columns: 1.1fr 1fr;
      gap: var(--space-xl);
    }
  }
  .hero__eyebrow {
    font-weight: 700;
    color: var(--color-text-muted);
    margin-bottom: var(--space-xs);
  }
  .hero__title {
    font-size: var(--step-4);
    max-width: 18ch;
  }
  .hero__lead {
    font-size: var(--step-1);
    max-width: var(--measure);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    margin-top: var(--space-m);
  }
</style>
