---
/**
 * Hero: the home page's opening band (dark green). Holds the only <h1> on the page.
 *
 * Layout: text on the left; on wide screens the photo fills the right half of the band, out
 * to the edge of the screen. Its left edge is two straight diagonals meeting in a large
 * rounded point, outlined in a thin, darker shade of the band (deep green). On small
 * screens the photo sits below the text, full width, with the same rounded point facing up.
 * The curve is an SVG clip path in relative units, so it scales with the band. Without
 * images (Hide images, Simplified page) the photo and curve are left out and the text
 * takes the full width.
 *
 * Props:
 * - eyebrow: short label above the heading
 * - title: the <h1> text
 * - image: imported hero photo (loaded with high priority)
 * - imageAlt: description of the photo, or "" if decorative
 * - level: 1 (default). Only the styleguide uses 2, to keep one <h1> per page.
 * - id: optional anchor id for links to the hero.
 *
 * One hero per page: the clip path ids (hero-clip-wide, hero-clip-narrow) are fixed.
 *
 * Slots: default (one-sentence explanation), "actions" (buttons; shown as pills here).
 */
import type { ImageMetadata } from 'astro';
import Photo from './Photo.astro';

interface Props {
  eyebrow?: string;
  title: string;
  image: ImageMetadata;
  imageAlt: string;
  level?: 1 | 2;
  id?: string;
}

const { eyebrow, title, image, imageAlt, level = 1, id } = Astro.props;
const Heading = `h${level}` as 'h1' | 'h2';

// One shape, two orientations. Units are fractions of the photo box (objectBoundingBox).
// Wide: a straight diagonal in from the top, a large rounded point at mid-height on the left,
// and a straight diagonal out to the bottom.
const wideEdge = 'M0.36,0 L0.13,0.27 C0.01,0.41 0.01,0.55 0.14,0.67 L0.6,1';
// Narrow: the same rounded point, facing up.
const narrowEdge = 'M0,0.2 L0.4,0.04 C0.46,0.01 0.54,0.01 0.6,0.04 L1,0.2';
---

<section class="hero on-dark" aria-labelledby="hero-title" id={id} tabindex={id ? -1 : undefined}>
  <svg class="hero__defs" width="0" height="0" aria-hidden="true" focusable="false">
    <defs>
      <clipPath id="hero-clip-wide" clipPathUnits="objectBoundingBox">
        <path d={`${wideEdge} L1,1 L1,0 Z`}></path>
      </clipPath>
      <clipPath id="hero-clip-narrow" clipPathUnits="objectBoundingBox">
        <path d={`${narrowEdge} L1,1 L0,1 Z`}></path>
      </clipPath>
    </defs>
  </svg>

  <div class="container hero__inner">
    <div class="hero__text">
      {eyebrow && <p class="hero__eyebrow triangle-marker">{eyebrow}</p>}
      <Heading id="hero-title" class="hero__title">
        {title}
      </Heading>
      <div class="hero__lead">
        <slot />
      </div>
      <div class="hero__actions">
        <slot name="actions" />
      </div>
    </div>
  </div>

  <div class="hero__media">
    <div class="hero__photo">
      <Photo
        src={image}
        alt={imageAlt}
        priority
        sizes="(min-width: 62rem) 70vw, 100vw"
        widths={[480, 720, 960, 1100]}
      />
    </div>
    <svg
      class="hero__edge hero__edge--wide"
      viewBox="0 0 1 1"
      preserveAspectRatio="none"
      aria-hidden="true"
      focusable="false"
    >
      <path d={wideEdge} vector-effect="non-scaling-stroke"></path>
    </svg>
    <svg
      class="hero__edge hero__edge--narrow"
      viewBox="0 0 1 1"
      preserveAspectRatio="none"
      aria-hidden="true"
      focusable="false"
    >
      <path d={narrowEdge} vector-effect="non-scaling-stroke"></path>
    </svg>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
  }
  .hero:focus {
    outline: none;
  }
  .hero__defs {
    position: absolute;
    width: 0;
    height: 0;
  }
  .hero__inner {
    position: relative;
    z-index: 1;
    padding-block: var(--space-xl) var(--space-l);
  }
  /* Centred in the green area */
  .hero__text {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .hero__eyebrow {
    font-weight: 700;
    color: var(--color-text-muted);
    margin-bottom: var(--space-xs);
  }
  .hero__title {
    font-size: clamp(2.1rem, 1.3rem + 3.2vw, 3.6rem);
    line-height: 1.12;
    max-width: 11.74em; /* = 18ch in Atkinson Bold; em, so it does not change when the font swaps in */
  }
  .hero__lead {
    font-size: var(--step-1);
    max-width: var(--measure);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-s);
    margin-top: var(--space-l);
  }
  /* Pill buttons, a little larger than elsewhere */
  .hero__actions :global(.button) {
    min-height: 3.25rem;
    padding-inline: var(--space-l);
    border-radius: 999px;
    font-size: var(--step-1);
  }

  /* The photo: full width under the text on small screens, wavy top */
  .hero__media {
    position: relative;
    height: clamp(15rem, 62vw, 26rem);
  }
  .hero__photo {
    position: absolute;
    inset: 0;
  }
  .hero__photo,
  .hero__photo :global(.photo),
  .hero__photo :global(picture) {
    display: block;
    height: 100%;
    margin: 0;
  }
  .hero__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 40% 50%; /* keep the teacher and children in frame when cropped */
    border-radius: 0;
  }
  .hero__photo {
    clip-path: url('#hero-clip-narrow');
  }
  .hero__edge {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: none;
    stroke: var(--color-dark-surface); /* a darker shade of the band, not a contrast colour */
    stroke-width: 4;
    stroke-linecap: round;
    pointer-events: none;
  }
  .hero__edge--wide {
    display: none;
  }

  /* Wide screens: the photo fills the right of the band, out to the screen edge */
  @media (min-width: 62rem) {
    .hero__inner {
      display: flex;
      align-items: center;
      min-height: clamp(32rem, 42vw, 40rem);
      padding-block: var(--space-2xl);
    }
    .hero__text {
      flex: 0 0 48%; /* the green part of the band, left of the photo */
      max-width: 48%;
    }
    .hero__media {
      position: absolute;
      top: 0;
      right: 0;
      bottom: 0;
      width: 50%;
      height: auto;
    }
    .hero__media .hero__photo {
      clip-path: url('#hero-clip-wide');
    }
    .hero__edge--wide {
      display: block;
    }
    .hero__edge--narrow {
      display: none;
    }
  }

  /* Without images: no photo, no curve; the text takes the full width */
  :global(:root[data-images='off']) .hero__media,
  :global(:root[data-simple='on']) .hero__media {
    display: none;
  }
  :global(:root[data-images='off']) .hero__text,
  :global(:root[data-simple='on']) .hero__text {
    max-width: none;
  }
  /*
   * Text animation: a gentle, one-time fade and rise as the page opens, staggered, all done
   * in under a second. Only when motion is allowed (not with the device's reduced motion,
   * Reduce motion, Calm colours or Simplified page). The text is never hidden without it.
   */
  @media (prefers-reduced-motion: no-preference) {
    :global([data-anim]) .hero__text > * {
      animation: hero-rise 0.6s ease-out both;
    }
    .hero__text > :nth-child(2) {
      animation-delay: 0.08s;
    }
    .hero__text > :nth-child(3) {
      animation-delay: 0.16s;
    }
    .hero__text > :nth-child(4) {
      animation-delay: 0.24s;
    }
  }
  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
  }

  /* A soft glow along the edge (Standard theme only, like the rest of the gloss) */
  .hero__edge {
    filter: drop-shadow(0 0 6px rgb(217 228 225 / 0.55))
      drop-shadow(0 0 2px rgb(255 255 255 / 0.35));
  }
  :global([data-theme]) .hero__edge,
  :global(:root[data-simple='on']) .hero__edge {
    filter: none;
  }
  @media (forced-colors: active) {
    .hero__edge {
      filter: none;
    }
  }
  /* High contrast: a clearly visible edge */
  :global([data-theme='contrast']) .hero__edge {
    stroke: var(--color-dark-text);
  }
</style>
