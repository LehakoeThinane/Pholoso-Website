---
/**
 * Field: one labelled form control (input, textarea or select) with optional hint and
 * error message, linked with aria-describedby. Optional fields say "(optional)";
 * the form states "All questions are required unless marked optional".
 *
 * Props:
 * - name, label: required
 * - type: 'text' | 'email' | 'tel' | 'number' | 'date' | 'textarea' | 'select' (default 'text')
 * - required: default false
 * - hint: short help shown under the label
 * - autocomplete, inputmode: use the correct values (WCAG 1.3.5), e.g. autocomplete="email"
 * - maxlength: always set one; the server enforces the same limits
 * - options: for selects, [{ value, label }]
 * - value: initial value (selected option for selects)
 * - rows: for textareas
 * - min, max, step: for number and date fields
 * - error: an error message to show now (used by the styleguide; at runtime the form
 *   script fills the same element)
 * - id: defaults to "f-<name>"
 */
type Option = { value: string; label: string };
interface Props {
  name: string;
  label: string;
  type?: 'text' | 'email' | 'tel' | 'number' | 'date' | 'textarea' | 'select';
  required?: boolean;
  hint?: string;
  autocomplete?: string;
  inputmode?: 'text' | 'email' | 'tel' | 'numeric' | 'decimal' | 'none';
  maxlength?: number;
  options?: Option[];
  value?: string;
  rows?: number;
  min?: string;
  max?: string;
  step?: string;
  error?: string;
  id?: string;
}

const {
  name,
  label,
  type = 'text',
  required = false,
  hint,
  autocomplete,
  inputmode,
  maxlength,
  options = [],
  value,
  rows = 6,
  min,
  max,
  step,
  error,
  id = `f-${name}`,
} = Astro.props;

const hintId = hint ? `${id}-hint` : undefined;
const errorId = `${id}-error`;
const describedBy = [hintId, error ? errorId : undefined].filter(Boolean).join(' ') || undefined;
const common = {
  id,
  name,
  required,
  'aria-describedby': describedBy,
  'aria-invalid': error ? ('true' as const) : undefined,
  'data-hint-id': hintId,
  'data-error-id': errorId,
};
---

<div class:list={['field', { 'field--error': error }]}>
  <label class="field__label" for={id}>
    {label}
    {!required && <span class="field__optional"> (optional)</span>}
  </label>
  {hint && (
    <p class="field__hint" id={hintId}>
      {hint}
    </p>
  )}
  <p class="field__error" id={errorId} hidden={!error}>
    <span class="visually-hidden">Error: </span>
    <span class="field__error-text">{error}</span>
  </p>
  {type === 'textarea' ? (
    <textarea
      {...common}
      class="field__control"
      rows={rows}
      maxlength={maxlength}
      autocomplete={autocomplete}
      set:text={value ?? ''}
    />
  ) : type === 'select' ? (
    <select {...common} class="field__control" autocomplete={autocomplete}>
      {options.map((o) => (
        <option value={o.value} selected={o.value === value}>
          {o.label}
        </option>
      ))}
    </select>
  ) : (
    <input
      {...common}
      class="field__control"
      type={type}
      value={value}
      maxlength={maxlength}
      autocomplete={autocomplete}
      inputmode={inputmode}
      min={min}
      max={max}
      step={step}
    />
  )}
</div>

<style>
  .field {
    margin-bottom: var(--space-m);
    max-width: 36rem;
  }
  .field__label {
    display: block;
    font-weight: 700;
    margin-bottom: var(--space-3xs);
  }
  .field__optional {
    font-weight: 400;
    color: var(--color-text-muted);
  }
  .field__hint {
    margin: 0 0 var(--space-2xs);
    color: var(--color-text-muted);
    font-size: var(--step--1);
  }
  .field__error {
    margin: 0 0 var(--space-2xs);
    color: var(--color-error);
    font-weight: 700;
  }
  .field__error[hidden] {
    display: none;
  }
  .field__control {
    display: block;
    width: 100%;
    min-height: var(--button-min);
    padding: var(--space-2xs) var(--space-xs);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-s);
    background-color: var(--color-bg);
    color: var(--color-text);
  }
  textarea.field__control {
    resize: vertical;
  }
  .field__control:focus-visible {
    outline-offset: 1px;
  }
  .field--error .field__control,
  .field__control[aria-invalid='true'] {
    border-color: var(--color-error);
    border-width: 3px;
  }
</style>
