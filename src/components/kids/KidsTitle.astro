---
/**
 * KidsTitle: the multicolour Kids' World title (brief v5 §7, mood board): Fredoka 700, each
 * letter a different kids' colour with a thick white outline, a soft shadow and a small tilt.
 * Screen readers hear the plain words (hidden text in the heading); the coloured letters are
 * hidden from them.
 * Styles: src/styles/kids.css (.kids-title). Colours: --kids-title-1…6 (per theme).
 *
 * Props: text (default "Kids’ World"), id, level (1 by default: it is the page's <h1>).
 */
interface Props {
  text?: string;
  id?: string;
  level?: 1 | 2;
}

const { text = 'Kids’ World', id, level = 1 } = Astro.props;
const Heading = `h${level}` as 'h1' | 'h2';
let n = 0;
const words = text.split(' ').map((w) => [...w].map((ch) => ({ ch, k: n++ % 6 })));
---

<Heading class="kids-title" id={id}>
  <span class="visually-hidden" data-read>
    {text}
  </span>
  {words.map((letters) => (
    <span class="kids-title__word" aria-hidden="true">
      {letters.map(({ ch, k }) => (
        <span class={`kids-title__l kt${k + 1}`}>{ch}</span>
      ))}
    </span>
  ))}
</Heading>
