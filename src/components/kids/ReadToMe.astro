---
/**
 * ReadToMe: the big "Read it to me" button on every Kids' World page. Reads the page (or one
 * block) aloud with the browser's own voice, in South African English where available.
 * Hidden unless the browser can speak; never starts by itself; press again to stop.
 * Behaviour: src/scripts/listen.ts (shared with the grown-ups' "Listen" buttons).
 *
 * Props:
 * - target: id of the element to read (default "main": the whole page content)
 * - label: what will be read, for screen readers (default "this page")
 * - size: 'large' (default, page level) or 'small' (one story)
 */
import { kids } from '../../config/strings';
import Art from './Art.astro';

interface Props {
  target?: string;
  label?: string;
  size?: 'large' | 'small';
}

const { target = 'main', label = 'this page', size = 'large' } = Astro.props;
---

<button
  type="button"
  class:list={['read-to-me', `read-to-me--${size}`]}
  data-listen={target}
  aria-pressed="false"
  data-speech-only
>
  <Art name="icons/speaker" class="read-to-me__art" />
  <span>
    {kids.readToMe}
    <span class="visually-hidden">: {label}</span>
  </span>
</button>

<style>
  .read-to-me {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    min-height: var(--kids-target);
    padding: var(--space-2xs) var(--space-m) var(--space-2xs) var(--space-s);
    border: 3px solid var(--color-text);
    border-radius: 999px;
    background: var(--kids-sky);
    color: var(--color-text);
    font-size: var(--step-1);
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 4px 0 var(--color-text);
  }
  .read-to-me[hidden] {
    display: none;
  }
  .read-to-me:active {
    box-shadow: 0 1px 0 var(--color-text);
    translate: 0 3px;
  }
  .read-to-me[aria-pressed='true'] {
    background: var(--color-text);
    color: var(--color-bg);
  }
  :global(.read-to-me__art) {
    width: 2.5rem;
    height: 2.5rem;
  }
  .read-to-me--small {
    min-height: var(--button-min);
    font-size: var(--step-0);
    padding-block: var(--space-3xs);
  }
  .read-to-me--small :global(.read-to-me__art) {
    width: 1.75rem;
    height: 1.75rem;
  }
</style>
