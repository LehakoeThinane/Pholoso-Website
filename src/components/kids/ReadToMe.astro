---
/**
 * ReadToMe: the big gold "Read it to me" button on every Kids' World page (brief v5 §10c).
 *
 * Plays a recording of the page (or one block): public/audio/en/<id>.mp3, where <id> comes
 * from the page address ("/kids/calm-corner/" -> "kids-calm-corner"; a block adds "--<target>").
 * The file downloads only when pressed. While it plays, Pause and Stop appear and Pholo talks.
 * If there is no recording yet, the browser's own voice reads instead (shown only where the
 * browser can speak). Never starts by itself. Behaviour: src/scripts/listen.ts.
 *
 * Making the recordings: docs/AUDIO.md (scripts/audio-texts.mjs, scripts/generate-audio.py).
 *
 * Props:
 * - target: id of the element to read (default "main": the whole page content)
 * - label: what will be read, for screen readers (default "this page")
 * - size: 'large' (default, page level) or 'small' (one story)
 */
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { kids } from '../../config/strings';
import Art from './Art.astro';

interface Props {
  target?: string;
  label?: string;
  size?: 'large' | 'small';
}

const { target = 'main', label = 'this page', size = 'large' } = Astro.props;
const page = Astro.url.pathname.replace(/^\/|\/$/g, '').replace(/\//g, '-') || 'home';
const id = target === 'main' ? page : `${page}--${target}`;
const audio = existsSync(join(process.cwd(), 'public', 'audio', 'en', `${id}.mp3`))
  ? `/audio/en/${id}.mp3`
  : undefined;
---

<span class="read-group" data-read-group>
  <button
    type="button"
    class:list={['read-to-me', `read-to-me--${size}`]}
    data-listen={target}
    data-audio-id={id}
    data-audio={audio}
    aria-pressed="false"
    data-speech-only={audio ? undefined : ''}
  >
    <Art name="icons/speaker" class="read-to-me__art" />
    <span>
      {kids.readToMe}
      <span class="visually-hidden">: {label}</span>
    </span>
  </button>
  {audio && (
    <>
      <button type="button" class="read-control" data-read-control="pause" hidden>
        Pause
      </button>
      <button type="button" class="read-control" data-read-control="stop" hidden>
        Stop
      </button>
    </>
  )}
</span>

<style>
  .read-group {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--space-xs);
  }
  .read-control {
    min-height: var(--target-min);
    padding: var(--space-3xs) var(--space-m);
    border: 3px solid var(--color-text);
    border-radius: 999px;
    background-color: var(--color-bg);
    color: var(--color-text);
    font-weight: 700;
    cursor: pointer;
  }
  .read-control[hidden] {
    display: none;
  }
  .read-to-me {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    min-height: var(--kids-target);
    padding: var(--space-2xs) var(--space-m) var(--space-2xs) var(--space-s);
    border: 3px solid var(--color-text);
    border-radius: 999px;
    background-color: var(--color-cta-bg); /* the big gold button (mood board) */
    background-image: var(--gloss);
    color: var(--color-cta-text);
    font-size: var(--step-1);
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 4px 0 var(--color-text);
  }
  .read-to-me[hidden] {
    display: none;
  }
  .read-to-me:active {
    box-shadow: 0 1px 0 var(--color-text);
    translate: 0 3px;
  }
  .read-to-me[aria-pressed='true'] {
    background-color: var(--color-text);
    color: var(--color-bg);
  }
  :global(.read-to-me__art) {
    width: 2.5rem;
    height: 2.5rem;
  }
  .read-to-me--small {
    min-height: var(--button-min);
    font-size: var(--step-0);
    padding-block: var(--space-3xs);
  }
  .read-to-me--small :global(.read-to-me__art) {
    width: 1.75rem;
    height: 1.75rem;
  }
</style>
