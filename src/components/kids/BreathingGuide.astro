---
/**
 * BreathingGuide: the Calm corner breathing exercise.
 *
 * The only continuous animation on the site, and only after a child presses Start:
 * a soft shape grows for 4 seconds (breathe in) and shrinks for 4 seconds (breathe out),
 * five times, then stops by itself. Stop works at any time. With reduced motion or Calm
 * colours there is no movement: the words and a big number count instead (4, 3, 2, 1).
 *
 * Without JavaScript, the written steps below are the exercise.
 * Behaviour: src/scripts/kids/breathing.ts. No props.
 */
---

<div class="breathe" data-breathe>
  <div class="breathe__stage" data-breathe-stage hidden>
    <div class="breathe__shape" data-breathe-shape aria-hidden="true">
      <span class="breathe__count" data-breathe-count></span>
    </div>
    <p class="breathe__status" data-breathe-status aria-live="polite">
      Press Start when you are ready.
    </p>
    <div class="breathe__buttons">
      <button type="button" class="breathe__button" data-breathe-start>
        Start breathing
      </button>
      <button type="button" class="breathe__button breathe__button--stop" data-breathe-stop hidden>
        Stop
      </button>
    </div>
  </div>

  <h3 class="breathe__steps-title">How to do it</h3>
  <ol class="breathe__steps">
    <li>Sit or stand comfortably.</li>
    <li>Breathe in slowly through your nose. Count to 4.</li>
    <li>Breathe out slowly through your mouth. Count to 4.</li>
    <li>Do it 5 times. Then see how you feel.</li>
  </ol>
</div>

<style>
  .breathe__stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-m);
    margin-bottom: var(--space-l);
  }
  .breathe__stage[hidden] {
    display: none;
  }
  .breathe__shape {
    display: grid;
    place-items: center;
    width: min(16rem, 70vw);
    aspect-ratio: 1;
    border-radius: 50%;
    border: 4px solid var(--color-text);
    background: var(--kids-sky);
    transform: scale(0.6);
  }
  .breathe__count {
    font-size: clamp(3rem, 2rem + 6vw, 5rem);
    font-weight: 700;
    line-height: 1;
  }
  .breathe__status {
    font-size: var(--step-3);
    font-weight: 700;
    text-align: center;
    min-height: 1.4em;
    margin: 0;
  }
  .breathe__buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-s);
  }
  .breathe__button {
    min-height: var(--kids-target);
    padding: var(--space-2xs) var(--space-l);
    border: 3px solid var(--color-text);
    border-radius: 999px;
    background: var(--kids-leaf);
    font-size: var(--step-1);
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 4px 0 var(--color-text);
  }
  .breathe__button[hidden] {
    display: none;
  }
  .breathe__button--stop {
    background: var(--color-bg);
  }
  .breathe__steps-title {
    font-size: var(--step-2);
  }
  .breathe__steps {
    font-size: var(--step-1);
  }
</style>
