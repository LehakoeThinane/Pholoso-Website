---
/**
 * PictureButton: a big, friendly picture link for children: an illustration and one or two
 * words. Always at least 64px tall (--kids-target). The words are the accessible name;
 * the picture is decorative.
 *
 * Props:
 * - href: where it goes (pages on this site only; use GrownUpGate for other websites)
 * - icon: illustration name, e.g. "icons/heart"
 * - label: one or two words
 * - colour: 'sky' | 'coral' | 'leaf' | 'lilac' | 'sunshine' | 'gold'
 * - size: 'nav' (header row, default) or 'door' (large cards on the Kids' World home)
 * - current: marks the current page
 * - hint: optional short line under the label (door size only)
 */
import type { KidsColour } from '../../config/strings';
import Art from './Art.astro';

interface Props {
  href: string;
  icon: string;
  label: string;
  colour: KidsColour;
  size?: 'nav' | 'door';
  current?: boolean;
  hint?: string | undefined;
}

const { href, icon, label, colour, size = 'nav', current = false, hint } = Astro.props;
---

<a
  href={href}
  class:list={['pic-btn', `pic-btn--${size}`, `kids-bg--${colour}`]}
  aria-current={current ? 'page' : undefined}
>
  <Art name={icon} class="pic-btn__art" />
  <span class="pic-btn__text">
    <span class="pic-btn__label">{label}</span>
    {hint && size === 'door' && <span class="pic-btn__hint">{hint}</span>}
  </span>
</a>

<style>
  .pic-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-3xs);
    min-height: var(--kids-target);
    height: 100%;
    padding: var(--space-2xs);
    border: 3px solid var(--color-text);
    border-radius: var(--radius-l);
    color: var(--color-text);
    font-weight: 700;
    text-align: center;
    text-decoration: none;
    line-height: 1.2;
    box-shadow: 0 4px 0 var(--color-text);
  }
  .pic-btn:hover .pic-btn__label {
    text-decoration: underline;
    text-decoration-thickness: 0.1em;
  }
  .pic-btn:active {
    box-shadow: 0 1px 0 var(--color-text);
    translate: 0 3px;
  }
  .pic-btn[aria-current='page'] {
    outline: 4px solid var(--color-text);
    outline-offset: 3px;
  }
  .pic-btn[aria-current='page'] .pic-btn__label {
    text-decoration: underline;
    text-decoration-thickness: 0.15em;
  }
  :global(.pic-btn__art) {
    width: 2.75rem;
    height: 2.75rem;
    flex: none;
  }
  .pic-btn__label {
    font-size: var(--step--1);
  }

  .pic-btn--door {
    /* Picture above the words, all centred: even space on every side */
    flex-direction: column;
    justify-content: center;
    gap: var(--space-xs);
    min-height: 7rem;
    padding: var(--space-m);
    border-radius: var(--radius-xl);
    text-align: center;
    box-shadow: 0 6px 0 var(--color-text);
  }
  .pic-btn--door :global(.pic-btn__art) {
    width: 5rem;
    height: 5rem;
  }
  .pic-btn--door .pic-btn__text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3xs);
  }
  .pic-btn--door .pic-btn__label {
    font-size: var(--step-2);
  }
  .pic-btn__hint {
    font-weight: 400;
  }

  @media (min-width: 48rem) {
    .pic-btn--nav :global(.pic-btn__art) {
      width: 3.25rem;
      height: 3.25rem;
    }
    .pic-btn--nav .pic-btn__label {
      font-size: var(--step-0);
    }
  }
  @media (forced-colors: active) {
    .pic-btn {
      border-color: LinkText;
    }
  }
</style>
