---
/**
 * KidsSky: the Kids' World backdrop pieces (brief v5 §10, mood board): a crayon sun with rays,
 * white clouds, scattered stars and a dashed doodle path. Flat colour, no gradients. Each piece
 * is positioned by CSS (src/styles/kids.css, .sky__*), behind the content, and never behind
 * text that needs it for contrast. Decorative: hidden from screen readers. Stars and the path
 * are doodles, hidden in Calm colours and Simplified page.
 *
 * The rough crayon look is a small SVG filter (feTurbulence + feDisplacementMap) defined once.
 */
const rays = Array.from({ length: 12 }, (_, i) => {
  const a = (i * Math.PI) / 6;
  const p = (r: number) =>
    `${(110 + r * Math.cos(a)).toFixed(1)} ${(110 + r * Math.sin(a)).toFixed(1)}`;
  return `M${p(82)} L${p(112)}`;
});
const star = (cx: number, cy: number, r: number) => {
  const i = r * 0.3;
  return `M${cx} ${cy - r} L${cx + i} ${cy - i} L${cx + r} ${cy} L${cx + i} ${cy + i} L${cx} ${cy + r} L${cx - i} ${cy + i} L${cx - r} ${cy} L${cx - i} ${cy - i} Z`;
};
const cloud =
  'M20 60 Q0 60 4 42 Q8 24 30 28 Q36 6 62 10 Q84 0 98 22 Q124 18 126 42 Q132 62 108 62 Z';
---

<div class="sky" aria-hidden="true">
  <svg class="sky__defs" width="0" height="0" focusable="false">
    <filter id="crayon" x="-10%" y="-10%" width="120%" height="120%">
      <feTurbulence type="fractalNoise" baseFrequency="0.8" numOctaves="2" seed="3" />
      <feDisplacementMap in="SourceGraphic" scale="3.5" />
    </filter>
  </svg>
  <svg class="sky__sun" viewBox="-4 -4 228 228" focusable="false">
    <circle class="sky__sun-glow" cx="110" cy="110" r="90" />
    <g filter="url(#crayon)">
      <g class="sky__rays">
        {rays.map((d) => (
          <path class="sky__ray" d={d} />
        ))}
      </g>
      <circle class="sky__sun-disc" cx="110" cy="110" r="70" />
    </g>
  </svg>
  <svg class="sky__cloud sky__cloud--1" viewBox="0 0 132 64" focusable="false">
    <path d={cloud} />
  </svg>
  <svg class="sky__cloud sky__cloud--2" viewBox="0 0 132 64" focusable="false">
    <path d={cloud} />
  </svg>
  <svg
    class="sky__doodles doodle"
    viewBox="0 0 1440 600"
    preserveAspectRatio="xMidYMid slice"
    focusable="false"
  >
    <g filter="url(#crayon)">
      <path class="sky__star sky__star--1" d={star(290, 110, 14)} />
      <path class="sky__star sky__star--2" d={star(900, 30, 10)} />
      <path class="sky__star sky__star--3" d={star(300, 455, 9)} />
      <path class="sky__star sky__star--4" d={star(690, 430, 11)} />
    </g>
    <path class="sky__path" d="M560 60 C620 10 660 110 720 60 S820 30 860 70" />
  </svg>
</div>
