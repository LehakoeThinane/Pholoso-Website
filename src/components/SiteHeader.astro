---
/**
 * SiteHeader: logo, primary navigation and the Donate button. Not sticky, so it can never
 * cover focused content (WCAG 2.4.11).
 *
 * Below 62rem the navigation becomes a disclosure menu when JavaScript runs: the button
 * and the collapsed state are set by CSS before the first paint (html.js), so nothing
 * jumps; src/scripts/menu.ts opens and closes it. Without JavaScript the full navigation
 * is simply shown.
 *
 * Props:
 * - currentPath: the page's path (for example "/about/"), used to mark the current link.
 */
import { Image } from 'astro:assets';
import logo from '../assets/logo/logo.png';
import { primaryNav, strings } from '../config/strings';
import Art from './kids/Art.astro';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const isCurrent = (href: string) => currentPath === href || currentPath.startsWith(href);
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__home" href="/">
      <Image
        src={logo}
        alt={strings.homeLinkLabel}
        width={240}
        densities={[1, 2]}
        loading="eager"
        class="site-header__logo"
      />
    </a>

    <a
      class="site-header__donate"
      href="/donate/"
      aria-current={isCurrent('/donate/') ? 'page' : undefined}
    >
      {strings.donate}
    </a>

    <button
      class="site-header__menu-button"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      data-js-only
    >
      {strings.menuButton}
    </button>

    <nav class="site-nav" id="site-nav" aria-label={strings.primaryNavLabel}>
      <ul class="site-nav__list">
        {primaryNav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
              class:list={{ 'site-nav__kids': item.icon }}
            >
              {item.icon && <Art name={item.icon} class="site-nav__icon" />}
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background-color: var(--color-bg);
    border-bottom: var(--border-width) solid var(--color-line);
  }
  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-s) var(--space-m);
    padding-block: var(--space-s);
  }
  .site-header__home {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
    margin-right: auto;
  }
  .site-header__logo {
    width: 12rem;
    max-width: 55vw;
    height: auto;
  }

  /* Donate: gold button, always visible */
  .site-header__donate {
    order: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--button-min);
    padding-inline: var(--space-m);
    border-radius: var(--radius-s);
    background-color: var(--color-cta-bg);
    background-image: var(--gloss);
    box-shadow: var(--gloss-shadow);
    color: var(--color-cta-text);
    border: var(--border-width) solid var(--color-cta-text);
    font-weight: 700;
    text-decoration: none;
  }
  .site-header__donate:hover {
    text-decoration: underline;
  }
  .site-header__donate:focus-visible {
    outline-color: var(--color-focus);
  }

  .site-header__menu-button {
    order: 3;
    min-height: var(--button-min);
    min-width: var(--button-min);
    padding-inline: var(--space-s);
    border: var(--border-width) solid var(--color-text);
    border-radius: var(--radius-s);
    background-color: var(--color-bg);
    font-weight: 700;
    cursor: pointer;
  }

  .site-nav {
    order: 4;
    flex-basis: 100%;
  }
  .site-nav__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .site-nav__list li {
    margin: 0;
    max-width: none;
  }
  .site-nav__list a {
    display: flex;
    align-items: center;
    min-height: var(--target-min);
    padding-inline: var(--space-2xs);
    font-weight: 700;
    text-decoration-thickness: 0.06em;
  }
  .site-nav__list a[aria-current='page'] {
    text-decoration-thickness: 0.2em;
  }
  /* Kids' World: always first, with the mascot, on a sunshine pill so children spot it */
  .site-nav__list .site-nav__kids {
    gap: var(--space-2xs);
    align-self: flex-start;
    padding-inline: var(--space-2xs) var(--space-s);
    border-radius: 999px;
    background-color: var(--kids-sunshine);
    color: var(--color-text);
  }
  :global(.site-nav__icon) {
    width: 2rem;
    height: 2rem;
    flex: none;
  }

  /* Small screens: the logo and the buttons do not fit side by side, so both rows are
     centred (logo on top; Donate and Menu together below) instead of hanging left */
  @media (max-width: 61.99rem) {
    .site-header__inner {
      justify-content: center;
    }
    .site-header__home {
      flex-basis: 100%;
      justify-content: center;
      margin-right: 0;
    }
    /* The opened menu is centred under them too */
    .site-nav__list {
      align-items: center;
    }
  }

  /* Small screens with JavaScript: collapsed until the menu button opens it */
  @media (max-width: 61.99rem) {
    :global(.js) .site-header:not([data-menu='open']) .site-nav {
      display: none;
    }
  }

  /*
   * Wide screens: two rows. Logo and Donate on top; the menu on its own centred row below.
   * The full menu (about 840px) plus logo and Donate does not fit beside each other inside the
   * page width, and squeezing it made links break onto two lines. Links never break here.
   */
  @media (min-width: 62rem) {
    .site-header__menu-button {
      display: none;
    }
    .site-nav {
      border-top: var(--border-width) solid var(--color-line);
      padding-top: var(--space-2xs);
    }
    .site-nav__list {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
      gap: var(--space-2xs) var(--space-s);
    }
    .site-nav__list a {
      white-space: nowrap;
    }
    .site-nav__list .site-nav__kids {
      align-self: center;
    }
  }
</style>
