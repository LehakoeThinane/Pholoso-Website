---
/**
 * SiteHeader: logo, primary navigation and the Donate button. Not sticky, so it can never
 * cover focused content (WCAG 2.4.11).
 *
 * Wide screens (62rem and up): one row: logo, the four menu entries, Donate.
 * Menu groups ("About", "Stories & resources", "Get involved") are native <details>
 * disclosures: they open on click or Enter (never on hover), work without JavaScript, and
 * screen readers announce them as collapsed or expanded. src/scripts/menu.ts adds: one open
 * at a time, Esc closes and returns focus, a click elsewhere or moving focus away closes.
 *
 * Small screens: the whole navigation becomes a disclosure behind the Menu button when
 * JavaScript runs (the button and collapsed state are set by CSS before the first paint, so
 * nothing jumps). Groups open in place inside it. Without JavaScript everything is shown.
 *
 * Props:
 * - currentPath: the page's path (for example "/about/"), used to mark the current link.
 */
import { Image } from 'astro:assets';
import logo from '../assets/logo/logo.png';
import { primaryNav, strings } from '../config/strings';
import Art from './kids/Art.astro';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const isCurrent = (href: string) => currentPath === href || currentPath.startsWith(href);
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__home" href="/">
      <Image
        src={logo}
        alt={strings.homeLinkLabel}
        width={240}
        densities={[1, 2]}
        loading="eager"
        class="site-header__logo"
      />
    </a>

    <a
      class="site-header__donate"
      href="/donate/"
      aria-current={isCurrent('/donate/') ? 'page' : undefined}
    >
      {strings.donate}
    </a>

    <button
      class="site-header__menu-button"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      data-js-only
    >
      {strings.menuButton}
    </button>

    <nav class="site-nav" id="site-nav" aria-label={strings.primaryNavLabel}>
      <ul class="site-nav__list">
        {primaryNav.map((item) =>
          'children' in item ? (
            <li>
              <details class="site-nav__group" data-nav-group>
                <summary
                  class:list={[
                    'site-nav__summary',
                    { 'is-current': item.children.some((c) => isCurrent(c.href)) },
                  ]}
                >
                  {item.label}
                  <svg
                    class="site-nav__chevron"
                    viewBox="0 0 12 8"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path d="M1.5 1.5 6 6l4.5-4.5" />
                  </svg>
                </summary>
                <ul class="site-nav__sub">
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        aria-current={isCurrent(child.href) ? 'page' : undefined}
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            </li>
          ) : (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
                class:list={{ 'site-nav__kids': item.icon }}
              >
                {item.icon && <Art name={item.icon} class="site-nav__icon" />}
                {item.label}
              </a>
            </li>
          ),
        )}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background-color: var(--color-bg);
    border-bottom: var(--border-width) solid var(--color-line);
  }
  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-s) var(--space-m);
    padding-block: var(--space-s);
  }
  .site-header__home {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
    margin-right: auto;
  }
  .site-header__logo {
    width: 12rem;
    max-width: 55vw;
    height: auto;
  }

  /* Donate: gold button, always visible */
  .site-header__donate {
    order: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--button-min);
    padding-inline: var(--space-m);
    border-radius: var(--radius-s);
    background-color: var(--color-cta-bg);
    background-image: var(--gloss);
    box-shadow: var(--gloss-shadow);
    color: var(--color-cta-text);
    border: var(--border-width) solid var(--color-cta-text);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }
  .site-header__donate:hover {
    text-decoration: underline;
  }
  .site-header__donate:focus-visible {
    outline-color: var(--color-focus);
  }

  .site-header__menu-button {
    order: 3;
    min-height: var(--button-min);
    min-width: var(--button-min);
    padding-inline: var(--space-s);
    border: var(--border-width) solid var(--color-text);
    border-radius: var(--radius-s);
    background-color: var(--color-bg);
    font-weight: 700;
    cursor: pointer;
  }

  .site-nav {
    order: 4;
    flex-basis: 100%;
  }
  .site-nav__list,
  .site-nav__sub {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-nav__list {
    display: flex;
    flex-direction: column;
  }
  .site-nav li {
    margin: 0;
    max-width: none;
  }
  .site-nav a,
  .site-nav__summary {
    display: flex;
    align-items: center;
    min-height: var(--target-min);
    padding-inline: var(--space-2xs);
    font-weight: 700;
    white-space: nowrap;
  }
  .site-nav a {
    text-decoration-thickness: 0.06em;
  }
  .site-nav a[aria-current='page'] {
    text-decoration-thickness: 0.2em;
  }

  /* Group headings: a button-like label with a chevron, no underline (they open, not go) */
  .site-nav__summary {
    gap: 0.4em;
    list-style: none;
    color: var(--color-link);
    cursor: pointer;
    border-radius: var(--radius-s);
  }
  .site-nav__summary::-webkit-details-marker {
    display: none;
  }
  .site-nav__summary:hover {
    text-decoration: underline;
    text-decoration-thickness: 0.06em;
    text-underline-offset: 0.18em;
  }
  /* The group holding the current page is marked the same way as a current link */
  .site-nav__summary.is-current {
    text-decoration: underline;
    text-decoration-thickness: 0.2em;
    text-underline-offset: 0.18em;
  }
  .site-nav__chevron {
    width: 0.75em;
    height: 0.5em;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .site-nav__group[open] .site-nav__chevron {
    rotate: 180deg;
  }

  /* Kids' World: always first, with the mascot, on a sunshine pill so children spot it */
  .site-nav .site-nav__kids {
    gap: var(--space-2xs);
    padding-inline: var(--space-2xs) var(--space-s);
    border-radius: 999px;
    background-color: var(--kids-sunshine);
    color: var(--color-text);
  }
  :global(.site-nav__icon) {
    width: 2rem;
    height: 2rem;
    flex: none;
  }

  /* Small screens: logo on top; Donate and Menu centred below; the opened menu centred, with
     groups opening in place under their heading */
  @media (max-width: 61.99rem) {
    .site-header__inner {
      justify-content: center;
    }
    .site-header__home {
      flex-basis: 100%;
      justify-content: center;
      margin-right: 0;
    }
    .site-nav__list {
      align-items: center;
    }
    .site-nav__group {
      text-align: center;
    }
    .site-nav__summary {
      justify-content: center;
    }
    .site-nav__sub {
      padding-bottom: var(--space-2xs);
    }
    .site-nav__sub a {
      justify-content: center;
      font-weight: 400;
    }
  }

  /* Small screens with JavaScript: collapsed until the menu button opens it */
  @media (max-width: 61.99rem) {
    :global(.js) .site-header:not([data-menu='open']) .site-nav {
      display: none;
    }
  }

  /* Wide screens: one row. Logo, the four menu entries (centred in the space), Donate. */
  @media (min-width: 62rem) {
    .site-header__inner {
      flex-wrap: nowrap;
    }
    .site-header__menu-button {
      display: none;
    }
    .site-nav {
      order: 1;
      flex: 1 1 auto;
      flex-basis: auto;
    }
    .site-nav__list {
      flex-direction: row;
      justify-content: center;
      align-items: center;
      gap: var(--space-s);
    }
    .site-nav__group {
      position: relative;
    }
    /* The open group: a small panel under its heading, above the page */
    .site-nav__sub {
      position: absolute;
      top: calc(100% + var(--space-2xs));
      left: 50%;
      translate: -50% 0;
      z-index: 30;
      min-width: 13rem;
      padding: var(--space-2xs);
      border: var(--border-width) solid var(--color-border);
      border-radius: var(--radius-m);
      background-color: var(--color-bg);
      background-image: var(--gloss-surface);
      box-shadow:
        0 4px 14px rgb(22 36 31 / 0.12),
        0 1px 2px rgb(22 36 31 / 0.08);
    }
    .site-nav__sub a {
      padding-inline: var(--space-s);
      border-radius: var(--radius-s);
    }
    .site-nav__sub a:hover {
      background-color: var(--color-surface);
    }
  }
  @media (forced-colors: active) {
    .site-nav__sub {
      border-color: CanvasText;
    }
  }
</style>
