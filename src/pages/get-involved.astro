---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import CardGrid from '../components/CardGrid.astro';
import DefinitionList from '../components/DefinitionList.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import Section from '../components/Section.astro';
import SectionHeading from '../components/SectionHeading.astro';
import TickList from '../components/TickList.astro';
import TrustBlock from '../components/TrustBlock.astro';
import { site } from '../config/site';
import family from '../assets/images/family.jpg';
---

<BaseLayout
  title="Get involved"
  description="Ways to support the Pholoso Afrika Foundation: give as a donor, partner as a company or funder, or work with us as a school or educator."
>
  <PageHero
    title="Partners do not simply give. They help redesign the system."
    lead="Inclusive, neurodivergent education is tied to human development, educational equity and long-term economic inclusion. There is a way in for everyone."
  />

  <Section labelledby="ways-title">
    <h2 id="ways-title" class="visually-hidden">
      Ways to get involved
    </h2>
    <CardGrid>
      <Card
        id="donors"
        tag="Donors and funders"
        title="Fund infrastructure, not just a programme"
        level={2}
        href="/donate/"
        linkText="See the donor case"
      >
        <TickList
          items={[
            'Section 18A tax-deductible giving under PBO 930090077',
            'Catalytic support for early, adaptive systems',
            'A legacy in a national model of inclusion',
          ]}
        />
      </Card>
      <Card
        id="partners"
        tag="Corporates and partners"
        title="Co-build inclusive education"
        level={2}
        href="/contact/?topic=partner"
        linkText="Start a conversation"
      >
        <TickList
          items={[
            'B-BBEE Socio-Economic Development value, because our beneficiaries are predominantly Black children with disabilities',
            'Skills Development value when you fund educator training',
            'CSI and ESG aligned, credible and brand-safe',
          ]}
        />
        <p class="caveat">
          B-BBEE value depends on your situation. Please confirm with your verification agency or
          adviser.
        </p>
      </Card>
      <Card
        id="schools"
        tag="Schools and educators"
        title="Partner on inclusive practice"
        level={2}
        href="/contact/?topic=school"
        linkText="Partner on a pilot"
      >
        <TickList
          items={[
            'Pilot 2to.iQ in controlled, supported settings',
            'Affirming, learner-centred teaching support',
            'Join a connected ecosystem of specialists',
          ]}
        />
      </Card>
    </CardGrid>
  </Section>

  <div class="photo-band">
    <div class="container">
      <Photo
        src={family}
        alt="A woman talks with a mother, a father and their young daughter around a table with a laptop and a notebook."
        sizes="(min-width: 72rem) 68rem, 100vw"
      />
    </div>
  </div>

  <Section labelledby="trust-title">
    <SectionHeading
      id="trust-title"
      title="Why you can trust this"
      lead="When the work carries this much responsibility, trust cannot be decorative. It is built into the model."
    />
    <TrustBlock />
  </Section>

  <Section variant="alt" labelledby="registration-title" narrow>
    <SectionHeading
      id="registration-title"
      title="Our registration details"
      lead="A registered Public Benefit Organisation. You can check these details before you give or partner with us."
    />
    <DefinitionList
      items={[
        { term: 'Name', value: site.name },
        { term: 'Organisation type', value: site.legalForm },
        { term: 'NPO number', value: site.registration.npo },
        { term: 'CIPC registration', value: site.registration.cipc },
        {
          term: 'PBO number',
          value: `${site.registration.pbo}${site.registration.section18A ? ' (Section 18A approved)' : ''}`,
        },
        { term: 'Founded', value: String(site.founded) },
      ]}
    />
    <p>
      Our policies are available on request.{' '}
      <a href="/contact/?topic=partner">Ask us for our policies</a>.
    </p>
  </Section>
</BaseLayout>

<style>
  .caveat {
    font-size: var(--step--1);
    color: var(--color-text-muted);
    margin-top: var(--space-s);
  }
  .photo-band {
    padding-block: var(--space-l);
  }
</style>
