---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { getCollection } from 'astro:content';
import Art from '../../components/kids/Art.astro';
import Bunting from '../../components/kids/Bunting.astro';
import ColourCard, { type CardColour } from '../../components/kids/ColourCard.astro';
import KidsSky from '../../components/kids/KidsSky.astro';
import KidsTitle from '../../components/kids/KidsTitle.astro';
import Pholo from '../../components/kids/Pholo.astro';
import ReadToMe from '../../components/kids/ReadToMe.astro';
import TornEdge from '../../components/kids/TornEdge.astro';
import { kids, kidsNav } from '../../config/strings';
import KidsLayout from '../../layouts/KidsLayout.astro';
import { dayNumber } from '../../lib/day-number';

const facts = await getCollection('kidsFacts');
// Without JavaScript the fact for the build date shows; with it, today's (same formula).
const buildFact = dayNumber(new Date()) % facts.length;
// Each fact has its own recording (fact-0.mp3, fact-1.mp3, …) when they have been made
const factAudio = facts.every((_, i) =>
  existsSync(join(process.cwd(), 'public', 'audio', 'en', `fact-${i}.mp3`)),
);

// The six doors' colours, as on the mood board
const doorColour: CardColour[] = ['coral-strong', 'ocean', 'grape', 'brand', 'berry', 'amber'];
const cast = ['lerato', 'sipho', 'zanele', 'thabo', 'kayla'];
---

<KidsLayout
  title="Kids’ World"
  description="A happy, calm place for children to play, read along, colour and learn. Made by the Pholoso Afrika Foundation."
>
  <div class="welcome kids-bg--sky">
    <KidsSky />
    <div class="container welcome__inner">
      <div class="welcome__text">
        <KidsTitle />
        <p class="welcome__lead">Hello! This is your place to play, learn and feel calm.</p>
        <ReadToMe />
      </div>
      <div class="welcome__pholo">
        <p class="bubble bubble--down">
          <span class="visually-hidden">{kids.mascotName} says: </span>
          Hi! I’m {kids.mascotName}. I’m so glad you’re here!
        </p>
        <div class="talk-slot" data-talk-slot>
          <Pholo tap play="arrive" class="welcome__mascot" />
          <Pholo pose="talk" class="welcome__mascot pholo--talker" />
        </div>
      </div>
    </div>
    <nav class="container welcome__doors" aria-label="Kids’ World activities">
      <ul class="colour-cards">
        {kidsNav.map((item, i) => (
          <li>
            <ColourCard
              href={item.href}
              label={item.label}
              icon={item.icon}
              colour={doorColour[i] ?? 'brand'}
              tilt={i + 1}
            />
          </li>
        ))}
      </ul>
    </nav>
    <TornEdge layers={['leaf', 'brand']} />
  </div>

  <section class="container kids-section" aria-labelledby="fact-title">
    <div class="fact kids-bg--lilac" data-read-skip>
      <Art name="mascot/thinking" class="fact__mascot" />
      <div>
        <h2 id="fact-title" class="fact__title">
          Did you know?
        </h2>
        <ul class="fact__list">
          {facts.map((f, i) => (
            <li data-fact hidden={i !== buildFact}>
              {f.data.text}
            </li>
          ))}
        </ul>
        <p class="fact__more">Come back tomorrow for a new one!</p>
        {factAudio && (
          <span class="read-group" data-read-group>
            <button
              type="button"
              class="read-to-me read-to-me--small"
              data-listen="fact-title"
              data-fact-read
              data-audio={`/audio/en/fact-${buildFact}.mp3`}
              aria-pressed="false"
            >
              <Art name="icons/speaker" class="read-to-me__art" />
              <span>
                {kids.readToMe}
                <span class="visually-hidden">: today’s fact</span>
              </span>
            </button>
            <button type="button" class="read-control" data-read-control="pause" hidden>
              Pause
            </button>
            <button type="button" class="read-control" data-read-control="stop" hidden>
              Stop
            </button>
          </span>
        )}
      </div>
    </div>
  </section>

  <section class="container kids-section" aria-labelledby="welcome-title">
    <Bunting />
    <h2 id="welcome-title">Everyone is welcome here</h2>
    <p>Every child learns in their own way. Your way is a good way.</p>
    <div class="cast" aria-hidden="true">
      {cast.map((c) => (
        <Art name={`children/${c}`} class="cast__child" />
      ))}
    </div>
  </section>
</KidsLayout>

<style>
  .fact {
    display: grid;
    gap: var(--space-m);
    align-items: center;
    padding: var(--space-l);
    border: 3px solid var(--color-text);
    border-radius: var(--radius-xl);
    color: var(--color-text);
  }
  @media (min-width: 40rem) {
    .fact {
      grid-template-columns: 8rem 1fr;
    }
  }
  .fact :global(.fact__mascot) {
    width: 8rem;
    height: 8rem;
  }
  .fact__list {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-s);
  }
  .fact__list li {
    font-size: var(--step-2);
    font-weight: 700;
    line-height: 1.35;
  }
  .fact__more {
    margin: 0;
  }
  .cast {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-end;
    gap: var(--space-m);
    margin-top: var(--space-l);
  }
  .cast :global(.cast__child) {
    width: clamp(4.5rem, 14vw, 8rem);
    height: auto;
  }
</style>
