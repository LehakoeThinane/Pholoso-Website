---
/**
 * "What do you love?": the interest explorer as a game (brief §7).
 * With JavaScript: tap an interest, then tap its four cards to find ideas; when all four
 * are open, the mascot cheers "You're a great learner!".
 * Without JavaScript: every interest is shown, with its four cards (native <details>).
 * Content: src/content/kids/interests.yaml.
 */
import Art from '../../components/kids/Art.astro';
import FlipCard from '../../components/kids/FlipCard.astro';
import KidsHero from '../../components/kids/KidsHero.astro';
import type { KidsColour } from '../../config/strings';
import { kidsIdeaAreas } from '../../content.config';
import KidsLayout from '../../layouts/KidsLayout.astro';
import { ordered } from '../../lib/content';

const interests = await ordered('kidsInterests');
const cardColours: KidsColour[] = ['sky', 'coral', 'leaf', 'lilac'];
const areas = Object.entries(kidsIdeaAreas) as [
  keyof typeof kidsIdeaAreas,
  (typeof kidsIdeaAreas)[keyof typeof kidsIdeaAreas],
][];
---

<KidsLayout
  title="What do you love?"
  description="Tap the thing you love most, like trains, dinosaurs or football, and find fun ways to learn with it."
>
  <KidsHero
    title="What do you love?"
    says="Tap the thing you love. I’ll show you fun ideas!"
    pose="thinking"
    colour="coral"
  />

  <div class="container kids-section">
    <ul class="kids-grid kids-grid--small picker" data-picker="love-prompt" hidden>
      {interests.map((i) => (
        <li>
          <button
            type="button"
            class="picker__button"
            data-pick
            aria-pressed="false"
            aria-controls={`love-${i.id}`}
          >
            <Art name={`icons/${i.data.icon}`} class="picker__art" />
            <span>{i.data.name}</span>
          </button>
        </li>
      ))}
    </ul>
    <p class="kids-note picker__prompt" id="love-prompt" hidden>
      <Art name="icons/star" />
      Choose one to start!
    </p>

    {interests.map((i) => (
      <section
        class="love-panel"
        id={`love-${i.id}`}
        aria-labelledby={`love-${i.id}-title`}
        data-flip-group
      >
        <h2 id={`love-${i.id}-title`} class="love-panel__title">
          <Art name={`icons/${i.data.icon}`} class="love-panel__art" />
          You love {i.data.name.toLowerCase()}!
        </h2>
        <p>Tap each card to find an idea.</p>
        <ul class="kids-grid kids-grid--small">
          {areas.map(([key, area], n) => (
            <li>
              <FlipCard icon={`icons/${area.icon}`} front={area.label} colour={cardColours[n]!}>
                {i.data.ideas[key]}
              </FlipCard>
            </li>
          ))}
        </ul>
        <p class="love-panel__done" data-flip-done>
          <Art name="mascot/celebrating" class="love-panel__mascot" />
          <span>You’re a great learner!</span>
        </p>
      </section>
    ))}
  </div>
</KidsLayout>

<style>
  .picker {
    margin-bottom: var(--space-l);
  }
  .picker[hidden],
  .picker__prompt[hidden],
  .love-panel[hidden],
  .love-panel__done[hidden] {
    display: none;
  }
  .picker__button {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2xs);
    width: 100%;
    height: 100%;
    min-height: 7rem;
    padding: var(--space-s);
    border: 3px solid var(--color-text);
    border-radius: var(--radius-l);
    background: var(--color-bg);
    font-size: var(--step-1);
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 4px 0 var(--color-text);
  }
  .picker__button[aria-pressed='true'] {
    background: var(--kids-sunshine);
    outline: 4px solid var(--color-text);
    outline-offset: 3px;
  }
  .picker__button :global(.picker__art) {
    width: 3.5rem;
    height: 3.5rem;
  }
  .love-panel {
    margin-bottom: var(--space-2xl);
  }
  .love-panel__title {
    display: flex;
    align-items: center;
    gap: var(--space-s);
  }
  .love-panel__title:focus {
    outline: none;
  }
  .love-panel :global(.love-panel__art) {
    width: 3.5rem;
    height: 3.5rem;
    flex: none;
  }
  .love-panel__done {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    margin-top: var(--space-l);
    padding: var(--space-s) var(--space-m);
    border: 3px solid var(--color-text);
    border-radius: var(--radius-l);
    background: var(--kids-sunshine);
    font-size: var(--step-3) !important;
    font-weight: 700;
    max-width: none;
  }
  .love-panel :global(.love-panel__mascot) {
    width: 6rem;
    height: 6rem;
    flex: none;
  }
</style>
