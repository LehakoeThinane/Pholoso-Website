---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import CardGrid from '../components/CardGrid.astro';
import InterestExplorer from '../components/InterestExplorer.astro';
import explorerCss from '../styles/explorer.css?url';
import ListenButton from '../components/ListenButton.astro';
import PageHero from '../components/PageHero.astro';
import PartnerForParents from '../components/PartnerForParents.astro';
import Quote from '../components/Quote.astro';
import Section from '../components/Section.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { site } from '../config/site';
import { ordered } from '../lib/content';

const interests = (await ordered('interests')).map((i) => ({
  slug: i.id,
  name: i.data.name,
  title: i.data.title,
  cards: i.data.cards,
}));
---

<BaseLayout
  title="Our approach"
  description="How the Pholoso Afrika Foundation works: advocacy and awareness, learning technology with 2to.iQ, connecting the support around a child, and the Hlompho principle."
>
  <link slot="head" rel="stylesheet" href={explorerCss} />
  <PageHero
    title={site.coreIdea}
    lead={`${site.name} works on three fronts at once. Each one strengthens the others.`}
  />

  <Section labelledby="areas-title">
    <SectionHeading id="areas-title" title="Three fronts, working at once." />
    {/* The same cards as the home page's "Three fronts" (owner's request, 24 November 2026) */}
    <CardGrid>
      <Card title="Advocacy and awareness">
        <p>
          We help place neurodivergent children inside the national conversation on inclusion,
          education and community support. Visibility shifts attitudes. Attitudes shift systems.
        </p>
      </Card>
      <Card title="Educational innovation">
        <p>
          Through 2to.iQ, our edtech strategic partner, we build adaptive learning technology
          designed around how learners actually think, communicate and engage.
        </p>
      </Card>
      <Card title="Ecosystem building">
        <p>
          We connect the people around the child. Schools, parents, teachers, therapists,
          researchers and funders. Fragmented support helps no one. Connected support changes
          outcomes.
        </p>
      </Card>
    </CardGrid>
    <p class="sustain">{site.coreIdea} Sustain the change.</p>
  </Section>

  <Section id="for-parents" labelledby="parents-2toiq-title" class="partner-section">
    <div id="parents-2toiq-title" class="visually-hidden">
      For parents: learning activities from 2to.iQ
    </div>
    <PartnerForParents />
  </Section>

  <Section variant="dark" labelledby="hlompho-title" narrow>
    <div id="hlompho-text">
      <SectionHeading id="hlompho-title" title="The Hlompho principle" />
      <Quote cite={`The Hlompho principle, ${site.name}`}>
        A child's passion is not a side interest. It is something to be honoured, because it may be
        the clearest doorway into how they learn.
      </Quote>
      <p>
        <i lang="st">Hlompho</i> means respect, honour, and reverence. For us, it begins with the
        belief that every child carries something worthy of being seen before they are assessed,
        corrected, or asked to adapt. We begin with what the child loves, because interests often
        reveal how they think, communicate, engage and make sense of the world. Learning becomes
        more personal, more humane, and more capable of unlocking meaningful participation.
      </p>
    </div>
    <ListenButton target="hlompho-text" label="the Hlompho principle" />
  </Section>

  <Section labelledby="explorer-title">
    <SectionHeading
      id="explorer-title"
      title="Start with how a child learns, and the curriculum opens up."
      lead="Learner-centred, in action: a child's interest is not a distraction from learning. Used well, it is a doorway to all of it. Choose one, and see."
    />
    <InterestExplorer id="interests" interests={interests} />
  </Section>

  <Section variant="cta" labelledby="cta-title">
    <h2 id="cta-title" class="cta__title">
      Help build inclusive education that fits every mind.
    </h2>
    <p>
      Partners do not simply give. They help redesign the systems where neurodivergent children
      learn and belong.
    </p>
    <div class="cta__actions">
      <Button variant="green" href="/get-involved/">
        Get involved
      </Button>
      <Button variant="outline" href="/stories/">
        Hear the voices
      </Button>
    </div>
  </Section>
</BaseLayout>

<style>
  /* Same background as the band above: no double gap between them */
  :global(#for-parents) {
    padding-top: 0;
  }
  .sustain {
    margin: var(--space-l) auto 0;
    text-align: center;
    font-weight: 700;
  }
  .cta__title {
    font-size: var(--step-3);
  }
  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-s);
  }
</style>
