---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import DoorCard from '../components/DoorCard.astro';
import CardGrid from '../components/CardGrid.astro';
import ExternalLink from '../components/ExternalLink.astro';
import DashedPath from '../components/DashedPath.astro';
import HelpRouter from '../components/HelpRouter.astro';
import CookieNotice from '../components/CookieNotice.astro';
import Disclosure from '../components/Disclosure.astro';
import Hero from '../components/Hero.astro';
import Photo from '../components/Photo.astro';
import Quote from '../components/Quote.astro';
import Section from '../components/Section.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Stat from '../components/Stat.astro';
import Term from '../components/Term.astro';
import { site } from '../config/site';
import { stats } from '../config/sources';
import { ordered } from '../lib/content';
import { render } from 'astro:content';
import { isTodo } from '../lib/todo';
import hero from '../assets/images/hero.jpg';
import classroom from '../assets/images/classroom.jpg';

const [featured] = await ordered('stories', (s) => s.data.featured);
const storyNote = isTodo(site.stories.notice)
  ? 'The source of this story is being confirmed.'
  : site.stories.notice;

// FAQs right before the footer: the home questions, plus About questions marked "home"
const homeFaqs = (await ordered('faqs', (f) => f.data.page === 'home' || f.data.home !== undefined))
  .sort(
    (a, b) =>
      (a.data.page === 'home' ? a.data.order : (a.data.home ?? 0)) -
      (b.data.page === 'home' ? b.data.order : (b.data.home ?? 0)),
  )
  .map((f) => ({ id: f.id, question: f.data.question, body: f.body ?? '', f }));
const faqs = await Promise.all(
  homeFaqs.map(async (q) => ({ ...q, Content: (await render(q.f)).Content })),
);
/** Markdown answer as plain text, for the FAQ structured data */
const plain = (md: string) =>
  md
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    .replace(/[*_`#>]/g, '')
    .replace(/\s+/g, ' ')
    .trim();

const description =
  'Pholoso Afrika Foundation: a South African non-profit (Section 18A PBO) advancing inclusive education for neurodivergent children, including autism and ADHD.';

// Structured data for search engines and AI answer engines (schema.org): the organisation, the
// website, this page and its FAQs, linked by @id. A data block, not a script, so the
// Content-Security-Policy allows it.
const orgId = `${site.url}/#organization`;
const ngo = {
  '@type': 'NGO',
  '@id': orgId,
  name: site.name,
  legalName: site.name,
  alternateName: site.shortName,
  url: `${site.url}/`,
  logo: `${site.url}/logo.png`,
  image: `${site.url}/og-image.png`,
  email: site.email,
  description: `${site.name} advances inclusive, adaptive, learner-centred education for neurodivergent children across South Africa and the African continent, through advocacy, educational innovation with its edtech strategic partner 2to.iQ, and by connecting the schools, families and specialists around each child.`,
  slogan: site.tagline,
  foundingDate: String(site.founded),
  address: { '@type': 'PostalAddress', addressCountry: 'ZA' },
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'general enquiries',
    email: site.email,
    url: `${site.url}/contact/`,
    availableLanguage: ['English'],
  },
  knowsAbout: [
    'Inclusive education',
    'Neurodiversity',
    'Autism',
    'ADHD',
    'Adaptive learning',
    'Learner-centred education',
    'Education White Paper 6',
  ],
  ...(site.phone.startsWith('TODO:') ? {} : { telephone: site.phone }),
  ...(site.address.startsWith('TODO:') ? {} : { location: site.address }),
  areaServed: [
    { '@type': 'Country', name: 'South Africa' },
    { '@type': 'Continent', name: 'Africa' },
  ],
  identifier: [
    { '@type': 'PropertyValue', propertyID: 'NPO number', value: site.registration.npo },
    {
      '@type': 'PropertyValue',
      propertyID: 'PBO number (Section 18A)',
      value: site.registration.pbo,
    },
    {
      '@type': 'PropertyValue',
      propertyID: 'CIPC registration number',
      value: site.registration.cipc,
    },
  ],
};
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    ngo,
    {
      '@type': 'WebSite',
      '@id': `${site.url}/#website`,
      url: `${site.url}/`,
      name: site.name,
      alternateName: [site.shortName, 'Pholoso'],
      inLanguage: 'en-ZA',
      publisher: { '@id': orgId },
    },
    {
      '@type': 'WebPage',
      '@id': `${site.url}/#webpage`,
      url: `${site.url}/`,
      name: `${site.name}: inclusive education for neurodivergent children in South Africa`,
      description,
      inLanguage: 'en-ZA',
      isPartOf: { '@id': `${site.url}/#website` },
      about: { '@id': orgId },
      primaryImageOfPage: `${site.url}/og-image.png`,
    },
    {
      '@type': 'FAQPage',
      '@id': `${site.url}/#faq`,
      mainEntity: faqs.map((q) => ({
        '@type': 'Question',
        name: q.question,
        acceptedAnswer: { '@type': 'Answer', text: plain(q.body) },
      })),
    },
  ],
};
---

<BaseLayout
  fullTitle={`${site.name}: inclusive, neurodiversity-first education`}
  description={description}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(graph)} />
  <Hero
    title={site.tagline}
    image={hero}
    imageAlt="A teacher helps a boy use a tablet at a classroom table, while other children draw. One child wears headphones."
  >
    <p>
      {site.name} advances inclusive, adaptive, learner-centred education for neurodivergent
      children, including <Term t="children-with-autism" /> and children with ADHD, across South
      Africa and the African continent. Learners should not have to bend to fit rigid systems. The
      systems should learn to fit the learner.
    </p>
  </Hero>

  <nav class="doors" aria-label="Choose your way in">
    <ul class="container doors__list">
      <li>
        <DoorCard href="/kids/" who="I’m a kid" action="Come and play!" variant="kid" />
      </li>
      <li>
        <DoorCard
          href="#help"
          who="I’m a grown-up"
          action="Find out about our work"
          variant="grown-up"
        />
      </li>
    </ul>
  </nav>

  <Section id="help" labelledby="help-router-title">
    <HelpRouter />
  </Section>
  <DashedPath />

  <Section id="our-work" labelledby="problem-title">
    <SectionHeading
      id="problem-title"
      title="Why this matters"
      lead="Neurodivergent learners sit within this underserved group, and many who do attend are placed in separate settings rather than supported within inclusive ones."
    />
    <CardGrid columns={2}>
      <Stat {...stats.outOfSchool} />
      <Stat {...stats.autismWorldwide} />
    </CardGrid>
  </Section>

  <div class="photo-band">
    <div class="container">
      <Photo
        src={classroom}
        alt="A teacher leans over a table where three children use tablets. A poster on the wall says: Everyone learns differently. Everyone belongs."
        sizes="(min-width: 72rem) 68rem, 100vw"
      />
    </div>
  </div>

  <Section variant="alt" labelledby="what-title">
    <SectionHeading id="what-title" title="Three fronts, working at once." lead={site.coreIdea} />
    <CardGrid>
      <Card title="Advocacy and awareness">
        <p>
          We place neurodivergent children inside the national conversation. Visibility shifts
          attitudes. Attitudes shift systems.
        </p>
      </Card>
      <Card title="Educational innovation">
        <p>
          Through 2to.iQ, our edtech strategic partner, we build adaptive learning technology
          designed around how learners actually think, communicate, and engage.
        </p>
      </Card>
      <Card title="Ecosystem building">
        <p>
          We connect the people around the child. Schools, parents, teachers, therapists,
          researchers and funders.
        </p>
      </Card>
    </CardGrid>
    <p class="after-cards">
      <a href="/approach/">See how we work</a>
    </p>
  </Section>

  <Section variant="dark" labelledby="partner-title">
    <SectionHeading
      id="partner-title"
      title="A neurodivergent-first platform that adapts to the child."
      lead="2to.iQ is the Foundation's edtech strategic partner. It is a wholly educational, neurodivergent-first platform offering adaptive learning that adapts to the child, not the child to the system. It personalises around how each learner thinks, communicates and engages."
    />
    <p class="partner__name">
      The name draws from the Sesotho word <i lang="st">Thuto</i>, meaning learning. Adaptive
      learning, built for African realities.
    </p>
    <div class="partner">
      <div class="partner__panel">
        <h3 class="partner__heading">Who does what</h3>
        <ul>
          <li>
            <strong>{site.name}</strong>, the social-impact engine, drives advocacy, awareness, and
            community-rooted impact.
          </li>
          <li>
            <strong>2to.iQ</strong>, our edtech strategic partner, builds the adaptive learning
            systems that make inclusive education practical, personalised, and scalable for African
            realities.
          </li>
        </ul>
      </div>
      <div class="partner__panel">
        <h3 class="partner__heading">For parents and caregivers</h3>
        <p>
          Looking for learning activities for your child? 2to.iQ offers calm, accessible activities
          that families, teachers and therapists use together.
        </p>
        <p class="partner__link">
          <ExternalLink href={site.partner.url}>Explore 2to.iQ →</ExternalLink>
        </p>
      </div>
    </div>
  </Section>

  {/* "Help for parents, right now" is hidden for now (owner's request, 23 November 2026).
       To bring it back, remove this comment and restore the GuideDemo and coach imports.
      <Section variant="alt" labelledby="guide-home-title">
        <SectionHeading
          id="guide-home-title"
          title="Help for parents, right now"
          lead="Tap the answer that fits, and get practical ideas to try at home. Our guides are drafts while professionals review them."
        />
        {coach.mode === 'off' ? (
          <GuideDemo cta />
        ) : (
          <GuideDemo cta ctaHref="/parent-coach/" ctaLabel={`Try ${coach.name}`} />
        )}
      </Section>
    */}

  {featured && (
    <Section variant="alt" labelledby="voice-title" narrow>
      <SectionHeading id="voice-title" title="In their words" />
      <Quote cite={featured.data.who} note={storyNote} large>
        {featured.data.quote}
      </Quote>
      <p class="after-quote">
        <a href="/stories/">Read the stories and what they ask us to change</a>
      </p>
    </Section>
  )}

  <Section id="faq" labelledby="home-faq-title" narrow>
    <SectionHeading
      id="home-faq-title"
      title="Questions families and funders ask"
      lead="Clear answers, in plain language."
    />
    {faqs.map(({ id, question, Content }) => (
      <Disclosure summary={question} level={3} id={`faq-${id}`}>
        <Content />
      </Disclosure>
    ))}
    <p class="after-quote">
      <a href="/donate/#giving-faq-title">Questions about giving and tax receipts</a>
    </p>
  </Section>
  <CookieNotice />
</BaseLayout>

<style>
  .doors {
    padding-block: var(--space-l);
    background-color: var(--color-bg);
  }
  .doors__list {
    list-style: none;
    margin-block: 0;
    display: grid;
    gap: var(--space-m);
  }
  .doors__list li {
    margin: 0;
    max-width: none;
  }
  @media (min-width: 48rem) {
    .doors__list {
      grid-template-columns: repeat(2, minmax(0, 1fr)); /* equal size */
      gap: var(--space-l);
    }
  }
  .photo-band {
    padding-block: var(--space-l);
  }
  .after-cards,
  .after-quote {
    margin-top: var(--space-l);
    margin-inline: auto;
    text-align: center;
    font-weight: 700;
  }
  /* 2to.iQ section: heading and introduction centred, then two matching panels */
  .partner__name {
    margin: calc(-1 * var(--space-s)) auto var(--space-l);
    text-align: center;
    color: var(--color-text-muted);
  }
  .partner {
    display: grid;
    gap: var(--space-m);
  }
  @media (min-width: 48rem) {
    .partner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .partner__panel {
    padding: var(--space-l);
    border: var(--border-width) solid var(--color-line);
    border-radius: var(--radius-l);
    background-color: var(--color-surface);
    background-image: var(--gloss-surface);
  }
  .partner__panel > :last-child {
    margin-bottom: 0;
  }
  .partner__heading {
    font-size: var(--step-1);
    margin-bottom: var(--space-s);
  }
  .partner__panel ul {
    padding-left: 1.2em;
  }
  .partner__link {
    font-weight: 700;
  }
</style>

<script>
  import '../scripts/legacy-redirect';
</script>
