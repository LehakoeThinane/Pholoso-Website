---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import CardGrid from '../components/CardGrid.astro';
import DataTable from '../components/DataTable.astro';
import Disclosure from '../components/Disclosure.astro';
import ListenButton from '../components/ListenButton.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Stat from '../components/Stat.astro';
import TrustBlock from '../components/TrustBlock.astro';
import { site } from '../config/site';
import { sources, stats } from '../config/sources';
import ExternalLink from '../components/ExternalLink.astro';
import { ordered } from '../lib/content';
import { render } from 'astro:content';

const faqs = await Promise.all(
  (await ordered('faqs', (f) => f.data.page === 'about')).map(async (f) => ({
    question: f.data.question,
    id: f.id,
    Content: (await render(f)).Content,
  })),
);

const values = [
  {
    title: 'Dignity first',
    text: 'Every learner is treated as capable. Being different is not a deficit.',
  },
  {
    title: 'Inclusion by design',
    text: 'We build for diversity from the start, never as an afterthought.',
  },
  {
    title: 'Adaptive, not standardised',
    text: 'Systems should flex around the learner, not the other way around.',
  },
  {
    title: 'Evidence informed',
    text: 'We learn from data, research and the lived experience of families and educators.',
  },
  {
    title: 'Collaboration over silos',
    text: 'Lasting change needs schools, families, therapists and communities working together.',
  },
  {
    title: 'African led',
    text: 'We build locally grounded solutions, measured against the best standards in the world.',
  },
];
---

<BaseLayout
  title="About us"
  description="Who the Pholoso Afrika Foundation is: our belief, mission, vision and values, the gap in inclusive education, and how we are governed."
>
  <PageHero
    title="Every child deserves to learn in a way that fits how their mind actually works."
    lead={`${site.name} is a South African registered non-profit company. We advance inclusive, adaptive, learner-centred support for neurodivergent children and learners, across schools, communities and families.`}
  />

  <Section labelledby="belief-title" narrow>
    <div id="belief-text">
      <SectionHeading id="belief-title" title="Difference is not deficit." />
      <p>
        Neurodivergent learners are not defined by limitation. They are defined by different ways of
        thinking, communicating, processing information and engaging with the world.
      </p>
      <p>
        Education systems should respond to that diversity. Learners should not have to bend
        themselves to fit rigid, standardised structures. The structures should learn to fit the
        learner.
      </p>
    </div>
    <ListenButton target="belief-text" label="what we believe" />
  </Section>

  <Section variant="alt" labelledby="entities-title">
    <SectionHeading
      id="entities-title"
      title="Two entities. One mission."
      lead="A conviction, turned into a working system. Both entities were structured on purpose, to combine social-impact delivery with long-term educational innovation."
    />
    <CardGrid columns={2}>
      <Card title={site.name} tag="The social-impact engine">
        <p>
          Drives advocacy, awareness, and community-rooted impact. Places neurodivergent children
          inside the national conversation on inclusion and education.
        </p>
      </Card>
      <Card title="2to.iQ (Pty) Ltd" tag="Edtech strategic partner">
        <p>
          Adaptive, neurodiversity-first learning systems built for African educational realities.{' '}
          <ExternalLink href={site.partner.url}>Explore 2to.iQ</ExternalLink>
        </p>
      </Card>
    </CardGrid>
    <p class="core-idea">{site.coreIdea}</p>
  </Section>

  <Section labelledby="mission-title" class="statements">
    <CardGrid columns={2}>
      <div>
        <h2 id="mission-title">Our mission: what we are here to do</h2>
        <p>
          To advance inclusive, adaptive, learner-centred educational support systems for
          neurodivergent children. We pursue this through advocacy, innovation, collaboration and
          community-driven engagement.
        </p>
      </div>
      <div>
        <h2>Our vision: the future we are building</h2>
        <p>
          A future in which neurodivergent children across South Africa and Africa are genuinely
          understood, supported and empowered. Built on education designed to recognise cognitive
          diversity rather than suppress it.
        </p>
      </div>
    </CardGrid>
  </Section>

  <Section variant="alt" labelledby="values-title">
    <SectionHeading
      id="values-title"
      title="What we stand for"
      lead="Six values, held in practice."
    />
    <CardGrid as="ul">
      {values.map((v) => (
        <li>
          <Card title={v.title}>
            <p>{v.text}</p>
          </Card>
        </li>
      ))}
    </CardGrid>
  </Section>

  <Section id="the-gap" labelledby="gap-title">
    <SectionHeading
      id="gap-title"
      title="The gap is not in the vision. It is in the implementation."
      lead="South Africa adopted its inclusive-education policy, White Paper 6, in 2001. Its intent aligns with the global standards that shaped the movement toward inclusion. For too many learners, daily reality still falls short."
    />
    <DataTable
      caption="Commitments to inclusive education"
      columns={['Year', 'Commitment', 'What it says']}
      rows={[
        ['1994', 'UNESCO Salamanca', 'The global benchmark for inclusive education.'],
        ['2001', 'SA White Paper 6', "South Africa's inclusive-education policy."],
        [
          '2006',
          'UN CRPD',
          'Affirms the right to inclusive education. South Africa ratified it in 2007.',
        ],
        ['2015', 'SDG 4', 'Inclusive, equitable quality education for all.'],
      ]}
    />
    <p>
      Read the policy:{' '}
      <ExternalLink href={sources.whitePaper6.href}>Education White Paper 6 on gov.za</ExternalLink>
    </p>
    <CardGrid columns={2}>
      <Stat {...stats.outOfSchool} />
      <Stat {...stats.policySince} />
    </CardGrid>
  </Section>

  <Section variant="alt" labelledby="trust-title">
    <SectionHeading
      id="trust-title"
      title="Why you can trust this"
      lead="When the work carries this much responsibility, trust cannot be decorative. It is built into the model."
    />
    <TrustBlock />
  </Section>

  <Section labelledby="faq-title" narrow>
    <SectionHeading
      id="faq-title"
      title="Questions families and funders ask"
      lead="Clear answers, in plain language."
    />
    {faqs.map(({ question, id, Content }) => (
      <Disclosure summary={question} level={3} id={`faq-${id}`}>
        <Content />
      </Disclosure>
    ))}
  </Section>
</BaseLayout>

<style>
  /* Mission and vision: short statements, centred like the other headings */
  :global(.statements) h2,
  :global(.statements) p {
    text-align: center;
    margin-inline: auto;
  }
  .core-idea {
    margin: var(--space-l) auto 0;
    text-align: center;
    font-weight: 700;
  }
</style>
