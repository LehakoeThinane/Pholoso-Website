# Pholoso Afrika Foundation - Apache configuration for the live site.
# Every block is wrapped in <IfModule>, so a missing module cannot cause a 500 error.
# If the site returns 500 after a deploy: rename this file to htaccess.txt, check the
# site loads, then re-enable the blocks one at a time (README, "Troubleshooting").

DirectoryIndex index.html
ErrorDocument 404 /404.html
Options -Indexes

# --- Never serve private or development files --------------------------------
# A backstop in case they are ever uploaded by mistake: answer 404, not 403, so nothing
# confirms that they exist. tests/php/htaccess-test.php checks these patterns.
<IfModule mod_alias.c>
  # Any dotfile or dot-folder (.git/, .env, .htaccess), except .well-known/
  RedirectMatch 404 (?i)/\.(?!well-known/)
  # Folders that never belong on the server; lib/ holds PHP included by contact.php only
  RedirectMatch 404 (?i)^/(docs|brand|tools|tests|scripts|src|lib|var|node_modules|dist|pholoso-private)(/|$)
  # Config, tooling and documentation files
  RedirectMatch 404 (?i)(^|/)config(\.example)?\.php$
  RedirectMatch 404 (?i)(^|/)(package\.json|pnpm-lock\.yaml|astro\.config\.\w+|tsconfig\.json)$
  RedirectMatch 404 (?i)\.(md|markdown|log|ini|bak|sql|py|sh|mjs|ts|zip)$
  # The previous site's sitemap address
  RedirectMatch 301 ^/sitemap\.xml$ /sitemap-index.xml
</IfModule>

# --- HTTPS and one canonical address -----------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  # www.pholoso.africa -> https://pholoso.africa in a single redirect
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
  # Force HTTPS. The X-Forwarded-Proto check avoids a loop on hosts that end SSL in front of Apache.
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
</IfModule>

# --- Security headers ----------------------------------------------------------
<IfModule mod_headers.c>
  # Strict policy: no inline scripts or styles anywhere (JSON-LD data blocks are not scripts).
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Microphone: this website only, for voice input in the Parent Coach (the browser asks first).
  Header always set Permissions-Policy "camera=(), microphone=(self), geolocation=(), payment=()"
  # HSTS for one year, sent only on HTTPS responses.
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
</IfModule>

# --- Caching -------------------------------------------------------------------
<IfModule mod_headers.c>
  # Pages (and the Parent Guide's guides.json) change with every update: browsers must check
  # for a new version.
  <FilesMatch "\.(html|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Unhashed files (favicon, logo, share image, prefs.js): cache briefly.
  <FilesMatch "\.(ico|png|jpg|js|txt|xml)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>
<IfModule mod_headers.c>
  # Files in /_astro/ have a content hash in their name, so they never change.
  # <If> is applied after <FilesMatch>, so this wins for hashed .js and image files.
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>

# --- Types and compression ---------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml application/javascript text/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript text/javascript application/json application/xml image/svg+xml
</IfModule>
